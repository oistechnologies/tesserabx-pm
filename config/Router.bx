/**
 * tesserabx-pm module router.
 *
 * PM's external URL surface (/agent/pm, /pm, /agent/admin/pm) is
 * declared in settings.tesserabx.routeClaims in ModuleConfig.bx
 * and bound to ColdBox by the host's AddonRouteClaimsRegistrar on
 * `afterAspectsLoad`. That keeps the BUILD-PLAN paths exact and
 * sidesteps ColdBox 8's module-Router entryPoint auto-prefix.
 *
 * This router only handles routes under the entryPoint
 * `/tesserabx-pm/*`, which is reserved for any PM-internal admin
 * URLs that don't need to live on the agent or portal surfaces.
 * The single `/` route below targets the same Main.index handler
 * for parity, so a developer hitting the entry point gets the
 * placeholder rather than a 404 while exploring the module.
 */
class {

    function configure(){
        route( "/" ).withVerbs( "GET" ).to( "Main.index" );
    }

}

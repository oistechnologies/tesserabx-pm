<bx:output>
<bx:set local.p = prc.project >

<div class="container-fluid">
	<nav aria-label="breadcrumb" class="mb-2">
		<ol class="breadcrumb mb-0 small">
			<li class="breadcrumb-item"><a href="/agent/pm/projects" class="link-secondary">Projects</a></li>
			<li class="breadcrumb-item active" aria-current="page">#encodeForHTML( local.p.getName() )#</li>
		</ol>
	</nav>

	<div class="d-flex justify-content-between align-items-start mb-3 gap-3 flex-wrap">
		<div>
			<h1 class="mb-1 fs-3">#encodeForHTML( local.p.getName() )#</h1>
			<div class="d-flex gap-2 align-items-center text-body-secondary small">
				<bx:if local.p.getLifecycleStatus() eq "active">
					<span class="badge text-bg-success">active</span>
				<bx:elseif local.p.getLifecycleStatus() eq "archived">
					<span class="badge text-bg-secondary">archived</span>
				<bx:else>
					<span class="badge text-bg-info">#encodeForHTML( local.p.getLifecycleStatus() )#</span>
				</bx:if>
				<span class="badge text-bg-secondary">#encodeForHTML( local.p.getVisibilityScope() )#</span>
				<bx:if !!local.p.getTimeTrackingEnabled()>
					<span class="badge text-bg-info"><i class="bi bi-stopwatch"></i> time tracking on</span>
				</bx:if>
			</div>
		</div>
		<div class="d-flex gap-2">
			<a class="btn btn-outline-secondary" href="/agent/pm/projects/#encodeForURL( local.p.getId() )#/edit"><i class="bi bi-pencil"></i> Edit</a>
			<bx:if local.p.getLifecycleStatus() neq "archived">
				<form method="post" action="/agent/pm/projects/#encodeForURL( local.p.getId() )#/archive" class="d-inline"
					onsubmit="return confirm( 'Archive this project? It will be hidden from the default list but can be restored.' );">
					<button type="submit" class="btn btn-outline-warning"><i class="bi bi-archive"></i> Archive</button>
				</form>
			<bx:else>
				<form method="post" action="/agent/pm/projects/#encodeForURL( local.p.getId() )#/restore" class="d-inline">
					<button type="submit" class="btn btn-outline-success"><i class="bi bi-arrow-counterclockwise"></i> Restore</button>
				</form>
			</bx:if>
			<form method="post" action="/agent/pm/projects/#encodeForURL( local.p.getId() )#/delete" class="d-inline"
				onsubmit="return confirm( 'Soft-delete this project? It can be restored but will be hidden from PM views.' );">
				<button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
			</form>
		</div>
	</div>

	<div class="row g-3">
		<div class="col-12 col-lg-8">
			<div class="card">
				<div class="card-body">
					<h2 class="h5 mb-2">Description</h2>
					<bx:if len( local.p.getDescription() ?: "" )>
						<p class="mb-0" style="white-space: pre-wrap;">#encodeForHTML( local.p.getDescription() )#</p>
					<bx:else>
						<p class="text-body-secondary mb-0 fst-italic">No description.</p>
					</bx:if>
				</div>
			</div>

			<div class="card mt-3">
				<div class="card-body">
					<div class="d-flex justify-content-between align-items-center mb-2">
						<h2 class="h5 mb-0">Tasks</h2>
						<div class="d-flex gap-2">
							<a class="btn btn-sm btn-outline-secondary" href="/agent/pm/projects/#encodeForURL( local.p.getId() )#/tasks">
								<i class="bi bi-list"></i> Open board
							</a>
							<a class="btn btn-sm btn-primary" href="/agent/pm/projects/#encodeForURL( local.p.getId() )#/tasks/new">
								<i class="bi bi-plus-lg"></i> New task
							</a>
						</div>
					</div>
					<p class="text-body-secondary mb-0 small">The task board groups by project status. Click "Open board" to see the columns; the Phase 3 kanban view adds drag-and-drop.</p>
				</div>
			</div>

			<div class="mt-3">
				#wire(
					name   = "ProjectEventFeed@tesserabx-pm",
					params = {
						projectId      : local.p.getId(),
						organizationId : local.p.getOrganizationId()
					}
				)#
			</div>
		</div>

		<div class="col-12 col-lg-4">
			<div class="card">
				<div class="card-body">
					<h2 class="h6 mb-3">Details</h2>
					<dl class="row mb-0 small">
						<dt class="col-5">Organization</dt>
						<dd class="col-7"><code>#encodeForHTML( local.p.getOrganizationId() )#</code></dd>

						<dt class="col-5">Visibility</dt>
						<dd class="col-7">#encodeForHTML( local.p.getVisibilityScope() )#</dd>

						<dt class="col-5">Lifecycle</dt>
						<dd class="col-7">#encodeForHTML( local.p.getLifecycleStatus() )#</dd>

						<dt class="col-5">Time tracking</dt>
						<dd class="col-7">#!!local.p.getTimeTrackingEnabled() ? "enabled" : "disabled"#</dd>

						<dt class="col-5">Start</dt>
						<dd class="col-7">#toString( local.p.getStartDate() ?: "" )#</dd>

						<dt class="col-5">End</dt>
						<dd class="col-7">#toString( local.p.getEndDate() ?: "" )#</dd>

						<dt class="col-5">Template</dt>
						<dd class="col-7"><code>#encodeForHTML( local.p.getTemplateSourceId() ?: "(none)" )#</code></dd>

						<dt class="col-5">Created</dt>
						<dd class="col-7">#toString( local.p.getCreatedAt() ?: "" )#</dd>

						<dt class="col-5">Updated</dt>
						<dd class="col-7">#toString( local.p.getUpdatedAt() ?: "" )#</dd>

						<bx:if len( toString( local.p.getDeletedAt() ?: "" ) )>
							<dt class="col-5">Deleted</dt>
							<dd class="col-7 text-danger">#toString( local.p.getDeletedAt() )#</dd>
						</bx:if>
					</dl>
				</div>
			</div>
		</div>
	</div>
</div>
</bx:output>

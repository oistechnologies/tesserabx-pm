<bx:output>
<div class="container-fluid">
	<nav aria-label="breadcrumb" class="mb-2">
		<ol class="breadcrumb mb-0 small">
			<li class="breadcrumb-item"><a href="/agent/pm/projects" class="link-secondary">Projects</a></li>
			<li class="breadcrumb-item active" aria-current="page">New project</li>
		</ol>
	</nav>

	<h1 class="mb-3 fs-3">New project</h1>

	<bx:if arrayLen( prc.formErrors ?: [] )>
		<div class="alert alert-danger">
			<ul class="mb-0">
				<bx:loop array="#prc.formErrors#" item="err">
					<li>#encodeForHTML( err.message )#</li>
				</bx:loop>
			</ul>
		</div>
	</bx:if>

	<form method="post" action="/agent/pm/projects/new" class="card">
		<div class="card-body">
			<div class="row g-3">
				<div class="col-12 col-md-8">
					<label class="form-label" for="name">Name <span class="text-danger">*</span></label>
					<input type="text" class="form-control" id="name" name="name" required maxlength="255"
						value="#encodeForHTMLAttribute( prc.formData.name ?: "" )#">
				</div>
				<div class="col-12 col-md-4">
					<label class="form-label" for="organizationId">Organization <span class="text-danger">*</span></label>
					<select class="form-select" id="organizationId" name="organizationId" required>
						<option value="">Pick an organization...</option>
						<bx:loop array="#prc.organizations#" item="org">
							<option value="#encodeForHTMLAttribute( org.getId() )#"
								<bx:if ( prc.formData.organizationId ?: "" ) eq org.getId()> selected</bx:if>>
								#encodeForHTML( org.getName() )#
							</option>
						</bx:loop>
					</select>
				</div>

				<div class="col-12">
					<label class="form-label" for="description">Description</label>
					<textarea class="form-control" id="description" name="description" rows="3">#encodeForHTML( prc.formData.description ?: "" )#</textarea>
				</div>

				<div class="col-12 col-md-4">
					<label class="form-label" for="visibilityScope">Visibility</label>
					<select class="form-select" id="visibilityScope" name="visibilityScope">
						<option value="all_org_members"
							<bx:if ( prc.formData.visibilityScope ?: "all_org_members" ) eq "all_org_members"> selected</bx:if>>
							All organization members
						</option>
						<option value="specific_members"
							<bx:if ( prc.formData.visibilityScope ?: "" ) eq "specific_members"> selected</bx:if>>
							Specific members (configure post-create)
						</option>
					</select>
				</div>
				<div class="col-6 col-md-4">
					<label class="form-label" for="startDate">Start date</label>
					<input type="date" class="form-control" id="startDate" name="startDate"
						value="#encodeForHTMLAttribute( prc.formData.startDate ?: "" )#">
				</div>
				<div class="col-6 col-md-4">
					<label class="form-label" for="endDate">End date</label>
					<input type="date" class="form-control" id="endDate" name="endDate"
						value="#encodeForHTMLAttribute( prc.formData.endDate ?: "" )#">
				</div>

				<div class="col-12">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="timeTrackingEnabled" name="timeTrackingEnabled" value="true"
							<bx:if prc.formData.timeTrackingEnabled ?: false> checked</bx:if>>
						<label class="form-check-label" for="timeTrackingEnabled">
							Enable time tracking on this project
							<span class="text-body-secondary small d-block">Operators can log hours against tasks and subtasks. Toggle later under Edit.</span>
						</label>
					</div>
				</div>

				<div class="col-12">
					#wire(
						name   = "TemplatePicker@tesserabx-pm",
						params = { selectedTemplateId : prc.formData.templateSourceId ?: "" }
					)#
				</div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2">
			<a class="btn btn-outline-secondary" href="/agent/pm/projects">Cancel</a>
			<button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg"></i> Create project</button>
		</div>
	</form>
</div>
</bx:output>

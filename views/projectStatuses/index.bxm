<bx:output>
<div class="container-fluid">
	<nav aria-label="breadcrumb" class="mb-2">
		<ol class="breadcrumb mb-0 small">
			<li class="breadcrumb-item"><a href="/agent/pm/projects" class="link-secondary">Projects</a></li>
			<li class="breadcrumb-item"><a href="/agent/pm/projects/#encodeForURL( prc.project.getId() )#" class="link-secondary">#encodeForHTML( prc.project.getName() )#</a></li>
			<li class="breadcrumb-item active" aria-current="page">Statuses</li>
		</ol>
	</nav>

	<h1 class="fs-3 mb-1">#encodeForHTML( prc.project.getName() )# &mdash; Statuses</h1>
	<p class="text-body-secondary small mb-3">
		Add, rename, recolor, and reorder the kanban columns for this project. Mark one status as <em>Default</em> (new tasks land there) and any status as <em>Completed</em> (moving a task here auto-fills <code>completed_at</code>; moving away clears it).
	</p>

	#wire(
		name   = "StatusManager@tesserabx-pm",
		params = {
			projectId      : prc.project.getId(),
			organizationId : prc.project.getOrganizationId()
		}
	)#
</div>
</bx:output>

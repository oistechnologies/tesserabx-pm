<bx:output>
<div class="container py-3">
    <h1 class="mb-3 fs-3">Projects</h1>

    <bx:if !arrayLen( prc.projects ?: [] )>
        <p class="text-body-secondary fst-italic">No projects are shared with your account yet.</p>
    <bx:else>
        <div class="row g-3">
            <bx:loop array="#prc.projects#" item="p">
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">
                                <a href="/pm/projects/#encodeForURL( p.getId() )#" class="text-decoration-none">#encodeForHTML( p.getName() )#</a>
                            </h2>
                            <bx:if len( p.getDescription() ?: "" )>
                                <p class="text-body-secondary small mb-2">#encodeForHTML( p.getDescription() )#</p>
                            </bx:if>
                            <div class="small text-body-secondary">
                                <span class="badge text-bg-light border">#encodeForHTML( p.getLifecycleStatus() )#</span>
                                <bx:if len( toString( p.getStartDate() ?: "" ) )>
                                    <span class="ms-2"><i class="bi bi-calendar"></i> #toString( p.getStartDate() )#</span>
                                </bx:if>
                            </div>
                        </div>
                    </div>
                </div>
            </bx:loop>
        </div>
    </bx:if>
</div>
</bx:output>

<bx:output>
<bx:set local.project = prc.project >
<bx:set local.board   = prc.board >

<div class="container-fluid">
	<nav aria-label="breadcrumb" class="mb-2">
		<ol class="breadcrumb mb-0 small">
			<li class="breadcrumb-item"><a href="/agent/pm/projects" class="link-secondary">Projects</a></li>
			<li class="breadcrumb-item"><a href="/agent/pm/projects/#encodeForURL( local.project.getId() )#" class="link-secondary">#encodeForHTML( local.project.getName() )#</a></li>
			<li class="breadcrumb-item active" aria-current="page">Board</li>
		</ol>
	</nav>

	<div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
		<div>
			<h1 class="mb-0 fs-3">#encodeForHTML( local.project.getName() )#</h1>
			<p class="text-body-secondary mb-0 small">
				#local.board.totalTasks# task<bx:if local.board.totalTasks neq 1>s</bx:if>
				across #arrayLen( local.board.statuses )# column<bx:if arrayLen( local.board.statuses ) neq 1>s</bx:if>
			</p>
		</div>
		<a class="btn btn-primary" href="/agent/pm/projects/#encodeForURL( local.project.getId() )#/tasks/new">
			<i class="bi bi-plus-lg"></i> New task
		</a>
	</div>

	<!--- Filter card. Form-level GET so query params land in URL. --->
	<form method="get" action="/agent/pm/projects/#encodeForURL( local.project.getId() )#/tasks" class="card mb-3">
		<div class="card-body">
			<div class="row g-3">
				<div class="col-12 col-md-4">
					<label class="form-label" for="q">Search</label>
					<div class="input-group">
						<span class="input-group-text"><i class="bi bi-search"></i></span>
						<input type="search" class="form-control" id="q" name="q"
							placeholder="Title contains..."
							value="#encodeForHTMLAttribute( local.board.filters.search ?: "" )#">
					</div>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="priority">Priority</label>
					<select class="form-select" id="priority" name="priority">
						<option value="">Any priority</option>
						<bx:loop array="#[ "low", "medium", "high", "urgent" ]#" item="p">
							<option value="#p#" <bx:if ( local.board.filters.priority ?: "" ) eq p> selected</bx:if>>#p#</option>
						</bx:loop>
					</select>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="assigneeType">Assignee type</label>
					<select class="form-select" id="assigneeType" name="assigneeType">
						<option value="">Any</option>
						<option value="agent"   <bx:if ( local.board.filters.assigneeType ?: "" ) eq "agent">  selected</bx:if>>agent</option>
						<option value="contact" <bx:if ( local.board.filters.assigneeType ?: "" ) eq "contact">selected</bx:if>>contact</option>
					</select>
				</div>
				<div class="col-12 col-md-2 d-flex align-items-end gap-2">
					<button class="btn btn-primary flex-grow-1" type="submit">Apply</button>
					<a class="btn btn-outline-secondary" href="/agent/pm/projects/#encodeForURL( local.project.getId() )#/tasks">Reset</a>
				</div>
			</div>
		</div>
	</form>

	<!--- Kanban columns. Horizontal scroll if there are more than --->
	<!--- fit comfortably; each column is fixed-width.              --->
	<div class="d-flex gap-3 overflow-auto pb-2 pm-board">
		<bx:loop array="#local.board.statuses#" item="s">
			<bx:set local.bucket      = local.board.columns[ s.getId() ] >
			<bx:set local.headerStyle = len( s.getColor() ?: "" ) ? 'style="border-top: 4px solid ' & encodeForHTMLAttribute( s.getColor() ) & ';"' : "" >
			<div class="card flex-shrink-0 pm-column" style="width: 320px;">
				<div class="card-header d-flex align-items-center" #local.headerStyle#>
					<strong>#encodeForHTML( s.getName() )#</strong>
					<span class="badge text-bg-secondary ms-auto">#arrayLen( local.bucket.tasks )#</span>
				</div>
				<div class="card-body p-2 pm-column-body">
					<bx:if !arrayLen( local.bucket.tasks )>
						<p class="text-body-secondary small text-center mb-2 py-2 fst-italic">No tasks.</p>
					</bx:if>
					<bx:loop array="#local.bucket.tasks#" item="t">
						<a href="/agent/pm/tasks/#encodeForURL( t.getId() )#" class="card mb-2 text-decoration-none pm-task-card">
							<div class="card-body p-2">
								<div class="d-flex justify-content-between align-items-start gap-2">
									<strong class="text-body small">#encodeForHTML( t.getTitle() )#</strong>
									<span class="badge text-bg-#priorityBadge( t.getPriority() )#">#encodeForHTML( t.getPriority() )#</span>
								</div>
								<bx:if len( t.getAssigneeId() ?: "" )>
									<div class="text-body-secondary small mt-1">
										<i class="bi bi-person"></i> #encodeForHTML( t.getAssigneeType() )#
										<code class="ms-1">#encodeForHTML( left( t.getAssigneeId(), 8 ) )#…</code>
									</div>
								</bx:if>
								<div class="d-flex gap-2 align-items-center mt-1 small text-body-secondary">
									<bx:if len( toString( t.getDueDate() ?: "" ) )>
										<span><i class="bi bi-calendar"></i> #toString( t.getDueDate() )#</span>
									</bx:if>
									<bx:if !!t.getIsClientVisible()>
										<span title="Visible to clients"><i class="bi bi-eye"></i></span>
									</bx:if>
									<bx:if len( toString( t.getCompletedAt() ?: "" ) )>
										<span class="text-success"><i class="bi bi-check-circle"></i></span>
									</bx:if>
								</div>
							</div>
						</a>
					</bx:loop>
				</div>
				<!--- Quick-add input. Pressing Enter submits; an empty --->
				<!--- title is silently ignored by the server.            --->
				<form method="post" action="/agent/pm/projects/#encodeForURL( local.project.getId() )#/tasks/quick-add" class="card-footer p-2">
					<input type="hidden" name="statusId" value="#encodeForHTMLAttribute( s.getId() )#">
					<div class="input-group input-group-sm">
						<input type="text" class="form-control form-control-sm"
							name="title"
							placeholder="+ New in #encodeForHTMLAttribute( s.getName() )#"
							maxlength="500"
							autocomplete="off">
						<button class="btn btn-outline-primary btn-sm" type="submit" title="Add task"><i class="bi bi-plus-lg"></i></button>
					</div>
				</form>
			</div>
		</bx:loop>

		<!--- Tasks whose status_id is null or refers to a removed --->
		<!--- status row. Only rendered when non-empty.            --->
		<bx:if structKeyExists( local.board.columns, "" ) and arrayLen( local.board.columns[ "" ].tasks )>
			<div class="card flex-shrink-0 border-warning pm-column" style="width: 320px;">
				<div class="card-header d-flex align-items-center">
					<strong>(Unassigned status)</strong>
					<span class="badge text-bg-warning ms-auto">#arrayLen( local.board.columns[ "" ].tasks )#</span>
				</div>
				<div class="card-body p-2 pm-column-body">
					<bx:loop array="#local.board.columns[ "" ].tasks#" item="t">
						<a href="/agent/pm/tasks/#encodeForURL( t.getId() )#" class="card mb-2 text-decoration-none pm-task-card">
							<div class="card-body p-2">
								<strong class="text-body small">#encodeForHTML( t.getTitle() )#</strong>
								<p class="text-body-secondary mb-0 small mt-1">Reassign this task to a status to clear this bucket.</p>
							</div>
						</a>
					</bx:loop>
				</div>
			</div>
		</bx:if>
	</div>
</div>

<style>
.pm-board { min-height: 60vh; }
.pm-column { background: var(--bs-tertiary-bg); }
.pm-column-body { min-height: 80px; max-height: 60vh; overflow-y: auto; }
.pm-task-card { transition: transform .12s ease, box-shadow .12s ease; }
.pm-task-card:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.08); }
</style>
</bx:output>

<bx:script>
private string function priorityBadge( required string p ){
    switch ( arguments.p ) {
        case "urgent": return "danger";
        case "high":   return "warning";
        case "medium": return "secondary";
        case "low":    return "info";
        default:       return "secondary";
    }
}
</bx:script>

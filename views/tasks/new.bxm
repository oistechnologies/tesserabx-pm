<bx:output>
<bx:set local.project = prc.project >

<div class="container-fluid">
	<nav aria-label="breadcrumb" class="mb-2">
		<ol class="breadcrumb mb-0 small">
			<li class="breadcrumb-item"><a href="/agent/pm/projects" class="link-secondary">Projects</a></li>
			<li class="breadcrumb-item"><a href="/agent/pm/projects/#encodeForURL( local.project.getId() )#" class="link-secondary">#encodeForHTML( local.project.getName() )#</a></li>
			<li class="breadcrumb-item"><a href="/agent/pm/projects/#encodeForURL( local.project.getId() )#/tasks" class="link-secondary">Tasks</a></li>
			<li class="breadcrumb-item active" aria-current="page">New task</li>
		</ol>
	</nav>

	<h1 class="mb-3 fs-3">New task</h1>

	<bx:if arrayLen( prc.formErrors ?: [] )>
		<div class="alert alert-danger">
			<ul class="mb-0"><bx:loop array="#prc.formErrors#" item="err"><li>#encodeForHTML( err.message )#</li></bx:loop></ul>
		</div>
	</bx:if>

	<form method="post" action="/agent/pm/projects/#encodeForURL( local.project.getId() )#/tasks/new" class="card">
		<div class="card-body">
			<div class="row g-3">
				<div class="col-12">
					<label class="form-label" for="title">Title <span class="text-danger">*</span></label>
					<input type="text" class="form-control" id="title" name="title" required maxlength="500"
						value="#encodeForHTMLAttribute( prc.formData.title ?: "" )#">
				</div>
				<div class="col-12">
					<label class="form-label" for="description">Description</label>
					<textarea class="form-control" id="description" name="description" rows="4">#encodeForHTML( prc.formData.description ?: "" )#</textarea>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="statusId">Status</label>
					<select class="form-select" id="statusId" name="statusId">
						<option value="">(default)</option>
						<bx:loop array="#prc.statuses#" item="s">
							<option value="#encodeForHTMLAttribute( s.getId() )#"
								<bx:if ( prc.formData.statusId ?: "" ) eq s.getId()> selected</bx:if>>
								#encodeForHTML( s.getName() )#
							</option>
						</bx:loop>
					</select>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="priority">Priority</label>
					<select class="form-select" id="priority" name="priority">
						<bx:loop array="#[ "low", "medium", "high", "urgent" ]#" item="p">
							<option value="#p#" <bx:if ( prc.formData.priority ?: "medium" ) eq p> selected</bx:if>>#p#</option>
						</bx:loop>
					</select>
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="startDate">Start date</label>
					<input type="date" class="form-control" id="startDate" name="startDate"
						value="#encodeForHTMLAttribute( prc.formData.startDate ?: "" )#">
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="dueDate">Due date</label>
					<input type="date" class="form-control" id="dueDate" name="dueDate"
						value="#encodeForHTMLAttribute( prc.formData.dueDate ?: "" )#">
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="estimatedHours">Estimated hours</label>
					<input type="number" step="0.25" min="0" class="form-control" id="estimatedHours" name="estimatedHours"
						value="#encodeForHTMLAttribute( prc.formData.estimatedHours ?: "" )#">
				</div>
				<div class="col-6 col-md-3">
					<label class="form-label" for="assigneeType">Assignee type</label>
					<select class="form-select" id="assigneeType" name="assigneeType">
						<option value="">(unassigned)</option>
						<option value="agent"   <bx:if ( prc.formData.assigneeType ?: "" ) eq "agent">  selected</bx:if>>agent</option>
						<option value="contact" <bx:if ( prc.formData.assigneeType ?: "" ) eq "contact">selected</bx:if>>contact</option>
					</select>
				</div>
				<div class="col-12 col-md-6">
					<label class="form-label" for="assigneeId">Assignee id (uuid)</label>
					<input type="text" class="form-control font-monospace" id="assigneeId" name="assigneeId"
						placeholder="paste an agent or contact id"
						value="#encodeForHTMLAttribute( prc.formData.assigneeId ?: "" )#">
					<small class="form-text text-body-secondary">Phase 2c will switch this to a picker. For now paste a UUID; service rejects mismatched type/id pairs.</small>
				</div>
				<div class="col-12">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="isClientVisible" name="isClientVisible" value="true"
							<bx:if prc.formData.isClientVisible ?: false> checked</bx:if>>
						<label class="form-check-label" for="isClientVisible">
							Visible to clients
							<span class="text-body-secondary small d-block">Contacts in the project's org see this task even when they are not the assignee.</span>
						</label>
					</div>
				</div>
			</div>
		</div>
		<div class="card-footer d-flex justify-content-end gap-2">
			<a class="btn btn-outline-secondary" href="/agent/pm/projects/#encodeForURL( local.project.getId() )#/tasks">Cancel</a>
			<button class="btn btn-primary" type="submit"><i class="bi bi-plus-lg"></i> Create task</button>
		</div>
	</form>
</div>
</bx:output>

<bx:output>
<bx:script>
    // The host renders this partial via
    //   #view( view = local.p.partial, module = local.p.module )#
    // inside modules_app/agent/views/tickets/show.bxm with no `args`
    // struct, so we reach the ticket through `prc.ticket` directly.
    // We delegate to a CBWire so the panel can offer an ad-hoc
    // "create a PM task from this ticket" action without forcing
    // every interaction to round-trip through the page.
    local.ticket = prc.ticket ?: "";
</bx:script>

<bx:if !isSimpleValue( local.ticket )>
    #wire(
        name   = "LinkedTasksPanel@tesserabx-pm",
        params = {
            ticketId       : local.ticket.getId(),
            organizationId : local.ticket.getOrganizationId() ?: "",
            ticketSubject  : local.ticket.getSubject()        ?: ""
        }
    )#
</bx:if>
</bx:output>

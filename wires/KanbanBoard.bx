/**
 * KanbanBoard: the live, drag-and-drop project board.
 *
 * Embedded from the agent surface board view via
 *   #wire( name = "KanbanBoard@tesserabx-pm", params = { projectId : "..." } )#
 *
 * State (all URL-persisted via queryString):
 *   - q             : title search
 *   - priority      : low / medium / high / urgent or ""
 *   - assigneeType  : "agent" | "contact" | ""
 *   - assigneeId    : optional UUID
 *
 * Transient state (not URL-persisted):
 *   - detailTaskId  : when non-empty, the TaskDetail offcanvas
 *                     renders for that task
 *   - notice / noticeKind : transient alert above the board
 *
 * Drag-drop wiring: the template emits `data-pm-kanban-column` and
 * `data-pm-kanban-column-status` attributes on each column body, plus
 * `data-pm-task-id` on each card. resources/js/board.js (registered
 * via the assets manifest) calls Sortable.create on each column
 * during the livewire:init + component.init hook. The drag-end
 * callback calls `persistReorder(taskId, statusId, slotIndex)`
 * on this component.
 */
class extends="cbwire.models.Component" {

    property name="boardService"         inject="BoardService@tesserabx-pm";
    property name="projectService"       inject="ProjectService@tesserabx-pm";
    property name="taskService"          inject="TaskService@tesserabx-pm";
    property name="projectStatusService" inject="ProjectStatusService@tesserabx-pm";
    property name="labelService"         inject="LabelService@tesserabx-pm";
    property name="commentService"       inject="CommentService@tesserabx-pm";
    property name="auth"                 inject="AuthenticationService@cbauth";

    data = {
        "projectId"     : "",
        "q"             : "",
        "priority"      : "",
        "assigneeType"  : "",
        "assigneeId"    : "",
        "labelIds"      : [],
        "detailTaskId"  : "",
        // Quick-comment composer state on the off-canvas (Phase 13a polish).
        "quickComment"  : "",
        "quickInternal" : true,
        "notice"        : "",
        "noticeKind"    : "info"
    };

    queryString = [ "q", "priority", "assigneeType", "assigneeId", "labelIds" ];

    // ---------------- Lifecycle ----------------

    function onMount( required struct params = {} ){
        data.projectId = arguments.params.projectId ?: "";
    }

    // ---------------- Server-side helpers (called from template) ----------------

    function project(){
        if ( !len( data.projectId ) ) return "";
        return projectService.getProject( data.projectId );
    }

    function board(){
        if ( !len( data.projectId ) ) return { statuses : [], columns : { "" : { status : "", tasks : [] } }, totalTasks : 0, filters : {} };
        return boardService.buildBoard(
            projectId : data.projectId,
            filters   : {
                search       : data.q,
                priority     : data.priority,
                assigneeType : data.assigneeType,
                assigneeId   : data.assigneeId,
                labelIds     : data.labelIds
            }
        );
    }

    function projectLabels(){
        if ( !len( data.projectId ) ) return [];
        return labelService.listForProject( data.projectId );
    }

    function detailTask(){
        if ( !len( data.detailTaskId ) ) return "";
        return taskService.getTask( data.detailTaskId );
    }

    function statuses(){
        if ( !len( data.projectId ) ) return [];
        return projectStatusService.listForProject( data.projectId );
    }

    // ---------------- Actions ----------------

    /**
     * Drag-and-drop callback. Invoked from resources/js/board.js
     * after SortableJS reports a finished move.
     */
    function persistReorder( taskId, targetStatusId, targetIndex ){
        try {
            taskService.reorderTask(
                id             = arguments.taskId,
                targetStatusId = arguments.targetStatusId ?: "",
                targetIndex    = arguments.targetIndex ?: 0,
                data           = { actorType : "agent", actorId : currentAgentId() }
            );
        } catch ( any e ) {
            notice( "Could not move task: " & e.message, "danger" );
        }
    }

    /**
     * Quick-add a task to a specific status column. Empty titles
     * are ignored (the input clears via wire:model on the next
     * render). Bound to wire:submit on the column footer form.
     */
    function quickAdd( statusId, title ){
        var trimmed = trim( arguments.title ?: "" );
        if ( !len( trimmed ) ) return;
        var p = project();
        if ( isSimpleValue( p ) ) {
            notice( "Project not found.", "danger" );
            return;
        }
        try {
            taskService.createTask( {
                projectId      : p.getId(),
                organizationId : p.getOrganizationId(),
                title          : trimmed,
                statusId       : arguments.statusId ?: "",
                actorType      : "agent",
                actorId        : currentAgentId()
            } );
        } catch ( any e ) {
            notice( "Could not add task: " & e.message, "danger" );
        }
    }

    function openDetail( taskId ){
        data.detailTaskId  = arguments.taskId ?: "";
        // Reset the composer when opening a different task.
        data.quickComment  = "";
        data.quickInternal = true;
    }

    function closeDetail(){
        data.detailTaskId  = "";
        data.quickComment  = "";
        data.quickInternal = true;
    }

    /**
     * Off-canvas quick-comment composer (Phase 13a polish). Routes
     * through the same CommentService.createComment used by the full
     * CommentThread wire, so mention parsing, watcher auto-add,
     * `onPmCommentAdded` event, and downstream notifications all fire
     * the same way. Visibility toggle defaults to internal to match
     * the Comment thread composer.
     */
    function postQuickComment(){
        var body = trim( data.quickComment ?: "" );
        if ( !len( body ) ) return;
        if ( !len( data.detailTaskId ) ) return;
        try {
            var task = taskService.getTask( data.detailTaskId );
            if ( isNull( task ) ) {
                notice( "Cannot post; task vanished.", "danger" );
                return;
            }
            commentService.createComment( {
                commentableType : "task",
                commentableId   : task.getId(),
                organizationId  : task.getOrganizationId(),
                authorType      : "agent",
                authorId        : currentAgentId(),
                body            : body,
                isInternal      : !!data.quickInternal
            } );
            data.quickComment = "";
            notice( "Comment posted.", "success" );
        } catch ( any e ) {
            notice( "Could not post comment: " & e.message, "danger" );
        }
    }

    function clearFilters(){
        data.q            = "";
        data.priority     = "";
        data.assigneeType = "";
        data.assigneeId   = "";
        data.labelIds     = [];
    }

    function toggleLabel( labelId ){
        var lid = arguments.labelId ?: "";
        if ( !len( lid ) ) return;
        var next = duplicate( data.labelIds );
        if ( arrayContains( next, lid ) ) {
            arrayDelete( next, lid );
        } else {
            next.append( lid );
        }
        data.labelIds = next;
    }

    // ---------------- internals ----------------

    private string function currentAgentId(){
        try {
            var u = auth.getUser();
            return isNull( u ) ? "" : u.getId();
        } catch ( any e ) {
            return "";
        }
    }

    private void function notice( required string msg, string kind = "info" ){
        data.notice     = arguments.msg;
        data.noticeKind = arguments.kind;
    }

}

<bx:output>
<bx:script>
    local.proj      = project();
    local.r         = rows();
    local.statuses  = statuses();
    local.kbLabels  = projectLabels();
    local.priorities = [ "low", "medium", "high", "urgent" ];

    private string function sortIndicator( required string col ){
        if ( data.sort != arguments.col ) return "";
        return ( data.dir == "asc" ) ? " <i class=""bi bi-caret-up-fill""></i>" : " <i class=""bi bi-caret-down-fill""></i>";
    }
    private string function priorityBadge( required string p ){
        switch ( arguments.p ) {
            case "urgent": return "danger";
            case "high":   return "warning";
            case "medium": return "secondary";
            case "low":    return "info";
            default:       return "secondary";
        }
    }
</bx:script>

<div data-pm-wire-id="#_getID()#">
    <bx:if len( notice )>
        <div class="alert alert-#encodeForHTMLAttribute( noticeKind )# d-flex justify-content-between align-items-center mb-2 py-2" role="alert">
            <span>#encodeForHTML( notice )#</span>
            <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" wire:click="$set('notice','')"></button>
        </div>
    </bx:if>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <label class="form-label" for="tl-q">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="search" class="form-control" id="tl-q" wire:model.live.debounce.300ms="q" placeholder="Title contains...">
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="tl-priority">Priority</label>
                    <select class="form-select" id="tl-priority" wire:model.live="priority">
                        <option value="">Any priority</option>
                        <bx:loop array="#local.priorities#" item="p"><option value="#encodeForHTMLAttribute( p )#">#encodeForHTML( p )#</option></bx:loop>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="tl-assignee-type">Assignee type</label>
                    <select class="form-select" id="tl-assignee-type" wire:model.live="assigneeType">
                        <option value="">Any</option>
                        <option value="agent">agent</option>
                        <option value="contact">contact</option>
                    </select>
                </div>
                <div class="col-12 col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary w-100" wire:click="clearFilters">Reset</button>
                </div>
            </div>

            <bx:if arrayLen( local.kbLabels )>
                <div class="mt-3">
                    <label class="form-label small text-body-secondary mb-1"><i class="bi bi-tags"></i> Labels</label>
                    <div class="d-flex flex-wrap gap-1">
                        <bx:loop array="#local.kbLabels#" item="kbl">
                            <bx:set local.kbActive = arrayContains( data.labelIds, kbl.getId() ) >
                            <button type="button"
                                    class="btn btn-sm <bx:if local.kbActive>btn-primary<bx:else>btn-outline-secondary</bx:if>"
                                    wire:click="toggleLabel('#encodeForHTMLAttribute( kbl.getId() )#')"
                                    <bx:if local.kbActive and len( kbl.getColor() ?: "" )>style="background-color: #encodeForHTMLAttribute( kbl.getColor() )#; border-color: #encodeForHTMLAttribute( kbl.getColor() )#;"</bx:if>>
                                <bx:if local.kbActive><i class="bi bi-check-lg"></i></bx:if>
                                #encodeForHTML( kbl.getName() )#
                            </button>
                        </bx:loop>
                    </div>
                </div>
            </bx:if>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th style="cursor: pointer;" wire:click="setSort('title')">Title #sortIndicator( "title" )#</th>
                            <th style="cursor: pointer;" wire:click="setSort('status_id')">Status #sortIndicator( "status_id" )#</th>
                            <th style="cursor: pointer;" wire:click="setSort('priority')">Priority #sortIndicator( "priority" )#</th>
                            <th>Assignee</th>
                            <th style="cursor: pointer;" wire:click="setSort('due_date')">Due #sortIndicator( "due_date" )#</th>
                            <th>Labels</th>
                            <th style="cursor: pointer;" wire:click="setSort('created_at')">Created #sortIndicator( "created_at" )#</th>
                        </tr>
                    </thead>
                    <tbody>
                        <bx:if !arrayLen( local.r.tasks )>
                            <tr><td colspan="7" class="text-body-secondary fst-italic text-center py-3">No matching tasks.</td></tr>
                        </bx:if>
                        <bx:loop array="#local.r.tasks#" item="t">
                            <bx:set local.tid    = t.getId() >
                            <bx:set local.tStat  = local.r.statusMap[ t.getStatusId() ?: "" ] ?: "" >
                            <tr>
                                <td>
                                    <a href="/agent/pm/tasks/#encodeForURL( local.tid )#" class="text-decoration-none">#encodeForHTML( t.getTitle() )#</a>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            style="min-width: 9rem;"
                                            wire:change="inlineEdit('#encodeForHTMLAttribute( local.tid )#', 'statusId', $event.target.value)">
                                        <option value="">(none)</option>
                                        <bx:loop array="#local.statuses#" item="s">
                                            <option value="#encodeForHTMLAttribute( s.getId() )#" <bx:if t.getStatusId() eq s.getId()>selected</bx:if>>#encodeForHTML( s.getName() )#</option>
                                        </bx:loop>
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm"
                                            style="min-width: 7rem;"
                                            wire:change="inlineEdit('#encodeForHTMLAttribute( local.tid )#', 'priority', $event.target.value)">
                                        <bx:loop array="#local.priorities#" item="p">
                                            <option value="#encodeForHTMLAttribute( p )#" <bx:if t.getPriority() eq p>selected</bx:if>>#encodeForHTML( p )#</option>
                                        </bx:loop>
                                    </select>
                                </td>
                                <td class="small">
                                    <bx:if len( t.getAssigneeId() ?: "" )>
                                        <span class="badge text-bg-secondary">#encodeForHTML( t.getAssigneeType() )#</span>
                                        <code class="ms-1">#encodeForHTML( left( t.getAssigneeId(), 8 ) )#…</code>
                                    <bx:else>
                                        <span class="text-body-secondary fst-italic">unassigned</span>
                                    </bx:if>
                                </td>
                                <td>
                                    <input type="date"
                                           class="form-control form-control-sm"
                                           style="min-width: 9rem;"
                                           value="#encodeForHTMLAttribute( isDate( t.getDueDate() ?: '' ) ? dateFormat( t.getDueDate(), 'yyyy-mm-dd' ) : '' )#"
                                           wire:change="inlineEdit('#encodeForHTMLAttribute( local.tid )#', 'dueDate', $event.target.value)">
                                </td>
                                <td>
                                    <bx:set local.tlabels = local.r.labelsByTask[ local.tid ] ?: [] >
                                    <bx:loop array="#local.tlabels#" item="lbl">
                                        <span class="badge rounded-pill me-1"
                                              style="font-size: 0.65rem; <bx:if len( lbl.color )>background-color: #encodeForHTMLAttribute( lbl.color )#;<bx:else>background-color: var(##bs-secondary);</bx:if>">
                                            #encodeForHTML( lbl.name )#
                                        </span>
                                    </bx:loop>
                                </td>
                                <td class="small text-body-secondary">
                                    <bx:if isDate( t.getCreatedAt() ?: "" )>#dateFormat( t.getCreatedAt(), "yyyy-mm-dd" )#</bx:if>
                                </td>
                            </tr>
                        </bx:loop>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</bx:output>

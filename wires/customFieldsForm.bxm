<bx:output>
<bx:script>
    local.fields = fields();
</bx:script>

<div class="card" data-pm-wire-id="#_getID()#">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0"><i class="bi bi-pencil-square"></i> Custom fields</h2>
            <a href="/agent/pm/projects/#encodeForURL( data.projectId )#/custom-fields" class="small text-decoration-none"><i class="bi bi-gear"></i> Manage</a>
        </div>

        <bx:if len( notice )>
            <div class="alert alert-#encodeForHTMLAttribute( noticeKind )# d-flex justify-content-between align-items-center mb-3 py-2" role="alert">
                <span>#encodeForHTML( notice )#</span>
                <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" wire:click="$set('notice','')"></button>
            </div>
        </bx:if>

        <bx:if !arrayLen( local.fields )>
            <p class="text-body-secondary small fst-italic mb-0">No custom fields defined for this project yet. Use "Manage" to add some.</p>
        <bx:else>
            <form wire:submit.prevent="save">
                <bx:loop array="#local.fields#" item="f">
                    <bx:set local.fid     = f.getId() >
                    <bx:set local.fname   = f.getName() >
                    <bx:set local.ftype   = f.getFieldType() >
                    <bx:set local.current = data.values[ local.fid ] ?: "" >

                    <div class="mb-3">
                        <label class="form-label small mb-1" for="cff-#encodeForHTMLAttribute( local.fid )#">
                            #encodeForHTML( local.fname )#
                            <bx:if !!f.getIsRequired()><span class="text-danger">*</span></bx:if>
                            <span class="badge text-bg-light border ms-1">#encodeForHTML( local.ftype )#</span>
                        </label>

                        <bx:if local.ftype eq "text">
                            <input id="cff-#encodeForHTMLAttribute( local.fid )#" type="text" class="form-control form-control-sm"
                                   wire:model="values.#encodeForHTMLAttribute( local.fid )#">
                        <bx:elseif local.ftype eq "number">
                            <input id="cff-#encodeForHTMLAttribute( local.fid )#" type="number" step="any" class="form-control form-control-sm"
                                   wire:model="values.#encodeForHTMLAttribute( local.fid )#">
                        <bx:elseif local.ftype eq "date">
                            <input id="cff-#encodeForHTMLAttribute( local.fid )#" type="date" class="form-control form-control-sm"
                                   wire:model="values.#encodeForHTMLAttribute( local.fid )#">
                        <bx:elseif local.ftype eq "url">
                            <input id="cff-#encodeForHTMLAttribute( local.fid )#" type="url" class="form-control form-control-sm"
                                   wire:model="values.#encodeForHTMLAttribute( local.fid )#" placeholder="https://...">
                        <bx:elseif local.ftype eq "checkbox">
                            <div class="form-check form-switch">
                                <input id="cff-#encodeForHTMLAttribute( local.fid )#" type="checkbox" class="form-check-input"
                                       wire:model="values.#encodeForHTMLAttribute( local.fid )#"
                                       <bx:if isBoolean( local.current ) and !!local.current>checked</bx:if>>
                                <label class="form-check-label small" for="cff-#encodeForHTMLAttribute( local.fid )#">Yes</label>
                            </div>
                        <bx:elseif local.ftype eq "dropdown">
                            <select id="cff-#encodeForHTMLAttribute( local.fid )#" class="form-select form-select-sm"
                                    wire:model="values.#encodeForHTMLAttribute( local.fid )#">
                                <option value="">(choose)</option>
                                <bx:loop array="#optionsFor( f )#" item="opt">
                                    <option value="#encodeForHTMLAttribute( opt )#">#encodeForHTML( opt )#</option>
                                </bx:loop>
                            </select>
                        <bx:elseif local.ftype eq "multiselect">
                            <div class="d-flex flex-wrap gap-1">
                                <bx:loop array="#optionsFor( f )#" item="opt">
                                    <bx:set local.on = isSelected( local.fid, opt ) >
                                    <button type="button"
                                            class="btn btn-sm <bx:if local.on>btn-primary<bx:else>btn-outline-secondary</bx:if>"
                                            wire:click="toggleMulti('#encodeForHTMLAttribute( local.fid )#','#encodeForHTMLAttribute( opt )#')">
                                        <bx:if local.on><i class="bi bi-check-lg"></i></bx:if>
                                        #encodeForHTML( opt )#
                                    </button>
                                </bx:loop>
                            </div>
                        </bx:if>
                    </div>
                </bx:loop>
                <div class="text-end">
                    <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-check-lg"></i> Save fields</button>
                </div>
            </form>
        </bx:if>
    </div>
</div>
</bx:output>

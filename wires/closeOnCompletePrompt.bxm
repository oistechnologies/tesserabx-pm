<bx:output>
<bx:script>
    local.show    = shouldShow();
    local.pending = local.show ? pendingTickets() : [];
</bx:script>

<div data-pm-wire-id="#_getID()#">
    <bx:if local.show>
        <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-check-circle text-success"></i> Close linked tickets?</h5>
                        <button type="button" class="btn-close" aria-label="Dismiss" wire:click="dismiss"></button>
                    </div>
                    <div class="modal-body">
                        <p>This task is marked complete. The following linked tickets are still open. Close them?</p>

                        <bx:if len( notice )>
                            <div class="alert alert-#encodeForHTMLAttribute( noticeKind )# py-2 mb-3" role="alert">
                                #encodeForHTML( notice )#
                            </div>
                        </bx:if>

                        <ul class="list-unstyled mb-0">
                            <bx:loop array="#local.pending#" item="row">
                                <bx:set local.tid     = row.ticket.getId() >
                                <bx:set local.checked = arrayContains( data.selectedTicketIds, local.tid ) >
                                <li class="border-top pt-2 pb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               id="cocp-#encodeForHTMLAttribute( local.tid )#"
                                               <bx:if local.checked>checked</bx:if>
                                               wire:click="toggle('#encodeForHTMLAttribute( local.tid )#')">
                                        <label class="form-check-label" for="cocp-#encodeForHTMLAttribute( local.tid )#">
                                            <strong>#encodeForHTML( row.ticket.getSubject() ?: "(no subject)" )#</strong>
                                            <span class="badge text-bg-light border ms-2">#encodeForHTML( row.ticket.getStatus() ?: "" )#</span>
                                            <span class="badge text-bg-secondary ms-1">#encodeForHTML( row.link.getLinkType() )#</span>
                                            <code class="ms-1 small text-body-secondary">#encodeForHTML( left( local.tid, 8 ) )#…</code>
                                        </label>
                                    </div>
                                </li>
                            </bx:loop>
                        </ul>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" wire:click="dismiss">Leave open</button>
                        <button type="button" class="btn btn-primary" wire:click="closeSelected">
                            <i class="bi bi-check2-square"></i> Close selected (#arrayLen( data.selectedTicketIds )#)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </bx:if>
</div>
</bx:output>

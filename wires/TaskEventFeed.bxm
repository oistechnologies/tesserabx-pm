<bx:output>
<bx:set local.events = events() >
<bx:set local.bodyId = "tef-body-" & _getID() >

<div class="card" data-pm-wire-id="#_getID()#">
<div class="card-header py-2">
<button class="btn btn-link p-0 d-flex justify-content-between align-items-center w-100 text-decoration-none collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#char(35)##encodeForHTMLAttribute( local.bodyId )#" aria-expanded="false" aria-controls="#encodeForHTMLAttribute( local.bodyId )#">
<h2 class="h6 mb-0 text-body"><i class="bi bi-clock-history"></i> Activity <span class="badge text-bg-secondary ms-1">#arrayLen( local.events )#</span></h2>
<i class="bi bi-chevron-down"></i>
</button>
</div>
<div class="collapse" id="#encodeForHTMLAttribute( local.bodyId )#">
<div class="card-body">
<div class="d-flex justify-content-between align-items-center mb-3">
<label class="form-label small mb-0 text-body-secondary me-2" for="tef-actor">Filter</label>
<select id="tef-actor" class="form-select form-select-sm" wire:model.live="actorFilter" style="min-width: 8rem;">
<option value="">All actors</option>
<option value="agent">Agent only</option>
<option value="contact">Contact only</option>
<option value="system">System only</option>
</select>
</div>
<bx:if !arrayLen( local.events )><p class="text-body-secondary small fst-italic mb-0">No activity yet.</p></bx:if>
<ul class="list-unstyled mb-0">
<bx:loop array="#local.events#" item="e">
<li class="border-start ps-3 pb-3 ms-1" style="border-color: var(--bs-border-color-translucent) !important; border-width: 2px !important;">
<div class="small text-body-secondary">
<bx:if e.getActorType() eq "agent"><i class="bi bi-person-badge"></i><bx:elseif e.getActorType() eq "contact"><i class="bi bi-person"></i><bx:else><i class="bi bi-gear"></i></bx:if>
#encodeForHTML( e.getActorType() )#
<bx:if len( e.getActorId() ?: "" )><code class="ms-1">#encodeForHTML( left( e.getActorId(), 8 ) )#…</code></bx:if>
<span class="ms-2">#dateTimeFormat( e.getCreatedAt(), "yyyy-mm-dd HH:nn" )#</span>
</div>
<div class="mt-1">
<strong>#encodeForHTML( replace( e.getAction(), "_", " ", "all" ) )#</strong>
</div>
</li>
</bx:loop>
</ul>
</div>
</div>
</div>
</bx:output>

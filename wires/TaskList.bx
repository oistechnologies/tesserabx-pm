/**
 * TaskList: sortable table view of the tasks in a project, the
 * "List" alternative to the kanban Board.
 *
 * Mirrors the kanban's filter set (search, priority, assignee,
 * labels) so a project's tasks render the same way from either
 * surface. Inline editing covers the three columns agents flip
 * frequently: status, priority, due date. Heavier edits (title,
 * description, assignee, etc.) still route through the task
 * detail page so the validation / event surface there does not
 * have to be duplicated.
 *
 * State (URL-persisted via queryString):
 *   q, priority, assigneeType, assigneeId, labelIds (filters)
 *   sort  : "title" | "status" | "priority" | "due_date" | "created_at"
 *   dir   : "asc" | "desc"
 *
 * Embed from views/tasks/list.bxm with:
 *
 *   #wire(
 *       name   = "TaskList@tesserabx-pm",
 *       params = { projectId : prc.project.getId() }
 *   )#
 */
class extends="cbwire.models.Component" {

    property name="boardService"          inject="BoardService@tesserabx-pm";
    property name="taskService"           inject="TaskService@tesserabx-pm";
    property name="projectService"        inject="ProjectService@tesserabx-pm";
    property name="projectStatusService"  inject="ProjectStatusService@tesserabx-pm";
    property name="labelService"          inject="LabelService@tesserabx-pm";
    property name="auth"                  inject="AuthenticationService@cbauth";

    data = {
        "projectId"    : "",
        "q"            : "",
        "priority"     : "",
        "assigneeType" : "",
        "assigneeId"   : "",
        "labelIds"     : [],
        "sort"         : "due_date",
        "dir"          : "asc",
        "notice"       : "",
        "noticeKind"   : "info"
    };

    queryString = [ "q", "priority", "assigneeType", "assigneeId", "labelIds", "sort", "dir" ];

    function onMount( required struct params = {} ){
        data.projectId = arguments.params.projectId ?: "";
    }

    // ---------------- Server-side helpers ----------------

    function project(){
        if ( !len( data.projectId ) ) return "";
        return projectService.getProject( data.projectId );
    }

    function statuses(){
        if ( !len( data.projectId ) ) return [];
        return projectStatusService.listForProject( data.projectId );
    }

    function projectLabels(){
        if ( !len( data.projectId ) ) return [];
        return labelService.listForProject( data.projectId );
    }

    function rows(){
        if ( !len( data.projectId ) ) return { tasks : [], statusMap : {}, labelsByTask : {} };

        // Reuse BoardService's filter pipeline (it already handles
        // labels in one batched query), then re-sort.
        var board = boardService.buildBoard(
            projectId : data.projectId,
            filters   : {
                search       : data.q,
                priority     : data.priority,
                assigneeType : data.assigneeType,
                assigneeId   : data.assigneeId,
                labelIds     : data.labelIds
            }
        );

        // Flatten columns into a single list (the board groups by
        // column for the kanban; for the list view we want the
        // entire flat result).
        var tasks = [];
        for ( var s in board.statuses ) {
            for ( var t in board.columns[ s.getId() ].tasks ) tasks.append( t );
        }
        if ( structKeyExists( board.columns, "" ) ) {
            for ( var t in board.columns[ "" ].tasks ) tasks.append( t );
        }

        applySort( tasks );

        // Status name lookup keyed by status_id for the inline-edit
        // dropdown + the rendered badge.
        var statusMap = {};
        for ( var s in board.statuses ) statusMap[ s.getId() ] = s;

        return {
            tasks        : tasks,
            statusMap    : statusMap,
            labelsByTask : board.labelsByTask
        };
    }

    // ---------------- Actions ----------------

    function setSort( column ){
        var col = arguments.column ?: "";
        var allowed = [ "title", "status_id", "priority", "due_date", "created_at" ];
        if ( !arrayContains( allowed, col ) ) return;
        if ( data.sort == col ) {
            data.dir = ( data.dir == "asc" ) ? "desc" : "asc";
        } else {
            data.sort = col;
            data.dir  = "asc";
        }
    }

    function inlineEdit( taskId, field, value ){
        if ( !arrayContains( [ "statusId", "priority", "dueDate" ], arguments.field ) ) return;
        try {
            var payload = { actorType : "agent", actorId : currentAgentId() };
            payload[ arguments.field ] = arguments.value;
            taskService.updateTask( arguments.taskId, payload );
            notice( "Updated.", "success" );
        } catch ( any e ) {
            notice( "Edit failed: " & e.message, "danger" );
        }
    }

    function clearFilters(){
        data.q            = "";
        data.priority     = "";
        data.assigneeType = "";
        data.assigneeId   = "";
        data.labelIds     = [];
    }

    function toggleLabel( labelId ){
        var lid = arguments.labelId ?: "";
        if ( !len( lid ) ) return;
        var next = duplicate( data.labelIds );
        if ( arrayContains( next, lid ) ) arrayDelete( next, lid );
        else                              next.append( lid );
        data.labelIds = next;
    }

    // ---------------- internals ----------------

    /**
     * In-place sort on the tasks array based on the current
     * (sort, dir). Quick entities expose the columns via getters;
     * we adapt to a raw comparator.
     */
    private void function applySort( required array tasks ){
        var col = data.sort;
        var asc = ( data.dir != "desc" );
        var getKey = function( required any t ){
            switch ( col ) {
                case "title":      return lCase( arguments.t.getTitle()    ?: "" );
                case "status_id":  return arguments.t.getStatusId()        ?: "";
                case "priority":   return priorityRank( arguments.t.getPriority() ?: "" );
                case "due_date":   return isDate( arguments.t.getDueDate() ) ? dateTimeFormat( arguments.t.getDueDate(),  "yyyy-mm-dd" ) : "9999-12-31";
                case "created_at": return isDate( arguments.t.getCreatedAt() ) ? dateTimeFormat( arguments.t.getCreatedAt(), "yyyy-mm-dd HH:nn:ss" ) : "";
            }
            return "";
        };
        arraySort( arguments.tasks, function( a, b ){
            var av = getKey( a );
            var bv = getKey( b );
            if ( av == bv ) return 0;
            var cmp = ( av < bv ) ? -1 : 1;
            return asc ? cmp : -cmp;
        } );
    }

    private numeric function priorityRank( required string p ){
        switch ( arguments.p ) {
            case "urgent": return 4;
            case "high":   return 3;
            case "medium": return 2;
            case "low":    return 1;
            default:       return 0;
        }
    }

    private string function currentAgentId(){
        try {
            var u = auth.getUser();
            return isNull( u ) ? "" : u.getId();
        } catch ( any e ) {
            return "";
        }
    }

    private void function notice( required string msg, string kind = "info" ){
        data.notice     = arguments.msg;
        data.noticeKind = arguments.kind;
    }

}

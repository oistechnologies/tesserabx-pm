<bx:output>
<bx:script>
    local.events = events();
</bx:script>

<div class="card" data-pm-wire-id="#_getID()#">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Activity <span class="badge text-bg-secondary">#arrayLen( local.events )#</span></h2>
            <div class="d-flex align-items-center gap-2">
                <label class="form-label small mb-0 text-body-secondary" for="tef-actor">Filter</label>
                <select id="tef-actor" class="form-select form-select-sm" wire:model.live="actorFilter" style="min-width: 8rem;">
                    <option value="">All actors</option>
                    <option value="agent">Agent only</option>
                    <option value="contact">Contact only</option>
                    <option value="system">System only</option>
                </select>
            </div>
        </div>

        <bx:if !arrayLen( local.events )>
            <p class="text-body-secondary small fst-italic mb-0">No activity yet.</p>
        </bx:if>

        <ul class="list-unstyled mb-0">
            <bx:loop array="#local.events#" item="e">
                <li class="border-start ps-3 pb-3 ms-1" style="border-color: var(##bs-border-color-translucent) !important; border-width: 2px !important;">
                    <div class="small text-body-secondary">
                        <bx:if e.getActorType() eq "agent"><i class="bi bi-person-badge"></i>
                        <bx:elseif e.getActorType() eq "contact"><i class="bi bi-person"></i>
                        <bx:else><i class="bi bi-gear"></i></bx:if>
                        #encodeForHTML( e.getActorType() )#
                        <bx:if len( e.getActorId() ?: "" )>
                            <code class="ms-1">#encodeForHTML( left( e.getActorId(), 8 ) )#…</code>
                        </bx:if>
                        <span class="ms-2">#dateTimeFormat( e.getCreatedAt(), "yyyy-mm-dd HH:nn" )#</span>
                    </div>
                    <div class="mt-1">
                        <strong>#encodeForHTML( replace( e.getAction(), "_", " ", "all" ) )#</strong>
                    </div>
                </li>
            </bx:loop>
        </ul>
    </div>
</div>
</bx:output>

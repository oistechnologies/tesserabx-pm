<bx:output>
<bx:script>
    local.matches   = rows();
    local.bodyId    = "rt-body-" & _getID();
    local.wrapStyle = !arrayLen( local.matches ) ? "display:none" : "";
</bx:script>

<div data-pm-wire-id="#_getID()#" style="#local.wrapStyle#">
    <div class="card">
        <div class="card-header py-2">
            <button class="btn btn-link p-0 d-flex justify-content-between align-items-center w-100 text-decoration-none collapsed"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#char(35)##local.bodyId#"
                    aria-expanded="false"
                    aria-controls="#encodeForHTMLAttribute( local.bodyId )#">
                <h2 class="h6 mb-0 text-body">
                    <i class="bi bi-stars"></i> Related tasks
                    <span class="badge text-bg-secondary ms-1">#arrayLen( local.matches )#</span>
                </h2>
                <i class="bi bi-chevron-down"></i>
            </button>
        </div>
        <div class="collapse" id="#encodeForHTMLAttribute( local.bodyId )#">
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <bx:loop array="#local.matches#" item="m">
                        <li class="border-top pt-2 pb-2">
                            <a href="/agent/pm/tasks/#encodeForURL( m.id )#" class="text-decoration-none">
                                <strong class="small">#encodeForHTML( m.title )#</strong>
                            </a>
                            <div class="small text-body-secondary">
                                <span class="badge text-bg-light border me-1">#scorePercent( m.distance )#% similar</span>
                                <bx:if len( m.priority )>
                                    <span class="badge text-bg-light border me-1">#encodeForHTML( m.priority )#</span>
                                </bx:if>
                                <span>in #encodeForHTML( m.project_name )#</span>
                            </div>
                        </li>
                    </bx:loop>
                </ul>
            </div>
        </div>
    </div>
</div>
</bx:output>

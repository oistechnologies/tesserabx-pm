<bx:output>
<bx:script>
    local.comments = comments();
    local.me       = viewer();
</bx:script>

<div class="card" data-pm-wire-id="#_getID()#">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0">Comments <span class="badge text-bg-secondary">#arrayLen( local.comments )#</span></h2>
            <bx:if aiEnabled() and arrayLen( local.comments )>
                <button type="button" class="btn btn-sm btn-outline-primary" wire:click="summarizeThread" <bx:if data.summarizing>disabled</bx:if>>
                    <bx:if data.summarizing><i class="bi bi-hourglass-split"></i> Summarizing...<bx:else><i class="bi bi-stars"></i> Summarize</bx:if>
                </button>
            </bx:if>
        </div>

        <bx:if len( data.summary ) or len( data.summaryError )>
            <div class="alert alert-light border mb-3">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <strong class="small"><i class="bi bi-stars"></i> Thread summary</strong>
                    <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" wire:click="clearSummary"></button>
                </div>
                <bx:if len( data.summaryError )>
                    <div class="small text-warning mt-1">#encodeForHTML( data.summaryError )#</div>
                <bx:else>
                    <p class="small mb-1 mt-1">#encodeForHTML( data.summary )#</p>
                    <bx:if arrayLen( data.summaryPoints )>
                        <ul class="small mb-1">
                            <bx:loop array="#data.summaryPoints#" item="kp">
                                <li>#encodeForHTML( kp )#</li>
                            </bx:loop>
                        </ul>
                    </bx:if>
                    <bx:if len( data.summaryNextStep )>
                        <div class="small text-body-secondary mb-0"><strong>Next step:</strong> #encodeForHTML( data.summaryNextStep )#</div>
                    </bx:if>
                </bx:if>
            </div>
        </bx:if>

        <bx:if len( notice )>
            <div class="alert alert-#encodeForHTMLAttribute( noticeKind )# d-flex justify-content-between align-items-center mb-3 py-2" role="alert">
                <span>#encodeForHTML( notice )#</span>
                <button type="button" class="btn-close btn-close-sm" aria-label="Dismiss" wire:click="$set('notice','')"></button>
            </div>
        </bx:if>

        <!--- Composer. Agent-side ships the is_internal toggle      --->
        <!--- defaulting true; Phase 11 portal composer omits it.    --->
        <form wire:submit.prevent="post" class="mb-3">
            <div class="mb-2">
                <textarea class="form-control"
                          rows="3"
                          maxlength="20000"
                          wire:model="body"
                          placeholder="Add a comment. Use @agent:slug or @contact:slug to mention."></textarea>
            </div>
            <div class="d-flex justify-content-between align-items-center">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="ct-internal" wire:model="isInternal">
                    <label class="form-check-label small" for="ct-internal">
                        Internal note <span class="text-body-secondary">(hidden from clients)</span>
                    </label>
                </div>
                <button class="btn btn-primary btn-sm" type="submit">
                    <i class="bi bi-send"></i> Post
                </button>
            </div>
        </form>

        <!--- Thread. Flat list ordered chronologically; Phase 4    --->
        <!--- v2 will indent replies under parent_comment_id.       --->
        <bx:if !arrayLen( local.comments )>
            <p class="text-body-secondary small fst-italic mb-0">No comments yet.</p>
        </bx:if>
        <bx:loop array="#local.comments#" item="c">
            <div class="border-top pt-3 mb-3">
                <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                    <div class="small">
                        <strong>
                            <bx:if c.getAuthorType() eq "agent"><i class="bi bi-person-badge"></i><bx:else><i class="bi bi-person"></i></bx:if>
                            #encodeForHTML( c.getAuthorType() )#
                        </strong>
                        <code class="text-body-secondary ms-1">#encodeForHTML( left( c.getAuthorId(), 8 ) )#…</code>
                        <span class="text-body-secondary ms-2">#toString( c.getCreatedAt() )#</span>
                        <bx:if !!c.getIsInternal()>
                            <span class="badge text-bg-warning ms-2"><i class="bi bi-shield-lock"></i> internal</span>
                        </bx:if>
                    </div>
                    <bx:if ( c.getAuthorType() eq local.me.accountType ) and ( c.getAuthorId() eq local.me.accountId )>
                        <button class="btn btn-link btn-sm text-danger p-0"
                                wire:click="deleteComment('#encodeForHTMLAttribute( c.getId() )#')"
                                wire:confirm="Delete this comment? It will soft-delete and can be restored from the database.">
                            <i class="bi bi-trash"></i>
                        </button>
                    </bx:if>
                </div>
                <div class="small" style="white-space: pre-wrap;">#mentionLink( c.getBody() )#</div>
            </div>
        </bx:loop>
    </div>
</div>
</bx:output>

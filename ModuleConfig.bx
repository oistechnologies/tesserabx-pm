/**
 * tesserabx-pm: Project Management for TesseraBX.
 *
 * A third-party TesseraBX add-on. Installs as a standard ColdBox 8
 * BoxLang module at modules/tesserabx-pm/ and participates in the
 * host's settings.tesserabx manifest contract documented in the host
 * repo at docs/EXTENSIONS.md.
 *
 * Phase 0 scaffold. The settings.tesserabx block carries the
 * foundation (addonId, displayName, version, version range,
 * requiresAi) and a placeholder for every registry contribution
 * PM will populate as phases land. Empty arrays are intentional;
 * the host's AddonRegistryService accepts them and a phase-by-phase
 * InstallSpec catches any registry that should have grown but did
 * not.
 *
 * Full build plan: docs/BUILD-PLAN.md.
 */
class {

    this.title              = "Project Management";
    this.author             = "OIS Technologies";
    this.webURL             = "https://github.com/oistechnologies/tesserabx-pm";
    this.description        = "Project Management add-on for the TesseraBX helpdesk platform.";
    this.version            = "0.0.1";
    this.viewParentLookup   = true;
    this.layoutParentLookup = true;
    // PM owns the `/agent/pm` URL space directly through its module
    // entryPoint (multi-segment, the same pattern the host's admin
    // module uses with entryPoint="agent/admin"). All PM agent-side
    // routes (Projects, Tasks, Subtasks, ProjectStatuses, etc.)
    // declared in config/Router.bx auto-prefix with /agent/pm; the
    // agent firewall regex `^agent($|/)` covers them automatically.
    //
    // The two cross-surface URLs (`/pm` on the portal and
    // `/agent/admin/pm` on the admin surface) are not reachable from
    // PM's own router because they live outside the entryPoint URL
    // space. They are bound through settings.tesserabx.routeClaims
    // and registered by the host's AddonRouteClaimsRegistrar on
    // afterAspectsLoad.
    this.entryPoint         = "agent/pm";
    this.modelNamespace     = "tesserabx-pm";
    this.cfmapping          = "tesserabx.modules.tesserabx-pm";
    this.autoMapModels      = false;
    this.dependencies       = [ "core", "contacts", "audit", "notifications", "ai", "api", "help" ];

    function configure(){
        variables.settings = {
            tesserabx : {
                // Foundation. minCoreVersion matches the host's
                // current appVersion (0.0.1); maxCoreVersion is
                // omitted so any host >= 0.0.1 accepts PM.
                addonId        : "tesserabx-pm",
                displayName    : "Project Management",
                version        : "0.0.1",
                minCoreVersion : "0.0.1",
                contributesTo  : [
                    "permissions", "roles", "navigation",
                    "adminPages", "settings", "routeClaims",
                    "apiResources", "webhookEvents", "assets",
                    "auditEvents", "dashboardWidgets",
                    "ticketPanels", "automationActions",
                    "notificationTemplates"
                ],
                requiresAi     : false,

                // Registry contributions. Each subsequent phase fills
                // the arrays it owns and adds matching probes to the
                // InstallSpec. The set of keys here mirrors the host
                // EXTENSIONS.md registry catalog; missing keys are
                // treated as empty by AddonRegistryService.

                // Phase 1: permissions, roles, navigation, admin
                // landing card, per-tenant settings.
                permissions : [
                    { id : "pm.view",          label : "View PM projects and tasks",            description : "Read PM data within the viewer's organization, subject to Option C visibility." },
                    { id : "pm.create",        label : "Create PM projects and tasks",          description : "Create projects, tasks, and subtasks." },
                    { id : "pm.edit",          label : "Edit PM projects and tasks",            description : "Update projects, tasks, subtasks, comments, labels, and custom field values." },
                    { id : "pm.delete",        label : "Delete PM projects and tasks",          description : "Soft-delete or archive projects, tasks, and subtasks." },
                    { id : "pm.assign-client", label : "Assign tasks to client users",          description : "Assign tasks to contacts (clients), not just agents. Agent-side only." },
                    { id : "pm.admin",         label : "Administer PM",                         description : "Manage templates, project status sets, per-project custom fields, per-tenant PM settings." }
                ],
                roles : [
                    {
                        id          : "pm-admin",
                        label       : "PM Admin",
                        description : "Full PM access including templates, custom fields, and per-tenant settings.",
                        surface     : "agent",
                        permissions : [ "pm.view", "pm.create", "pm.edit", "pm.delete", "pm.assign-client", "pm.admin" ]
                    },
                    {
                        id          : "pm-manager",
                        label       : "PM Manager",
                        description : "Manage projects and tasks; can assign work to clients.",
                        surface     : "agent",
                        permissions : [ "pm.view", "pm.create", "pm.edit", "pm.delete", "pm.assign-client" ]
                    },
                    {
                        id          : "pm-contributor",
                        label       : "PM Contributor",
                        description : "Create and edit projects and tasks; cannot delete or assign to clients.",
                        surface     : "agent",
                        permissions : [ "pm.view", "pm.create", "pm.edit" ]
                    },
                    {
                        id          : "pm-viewer",
                        label       : "PM Viewer",
                        description : "Read-only access to PM projects and tasks.",
                        surface     : "agent",
                        permissions : [ "pm.view" ]
                    },
                    {
                        id          : "pm-client-viewer",
                        label       : "PM Client Viewer",
                        description : "Client-side: read-only access to PM projects shared with their organization.",
                        surface     : "contact",
                        permissions : [ "pm.view" ]
                    },
                    {
                        id          : "pm-client-contributor",
                        label       : "PM Client Contributor",
                        description : "Client-side: read and edit access to PM projects shared with their organization.",
                        surface     : "contact",
                        permissions : [ "pm.view", "pm.edit" ]
                    }
                ],
                // Top-level URL claims for surfaces PM cannot reach
                // from its own module Router. /agent/pm is owned by
                // PM's entryPoint; the cross-surface URLs (portal,
                // admin landing card) and every /api/v1/pm/* REST
                // endpoint are declared here. The host's
                // AddonRouteClaimsRegistrar interceptor walks every
                // manifest's `routeClaims` and prepends each into
                // ColdBox's main router on `afterAspectsLoad`, so
                // claims match before the host's catch-all.
                routeClaims : [
                    // Cross-surface landing URLs.
                    { path : "/pm",                       verbs : "GET", module : "tesserabx-pm", handler : "Main",            action : "index" },
                    { path : "/agent/admin/pm",           verbs : "GET", module : "tesserabx-pm", handler : "Main",            action : "index" },
                    // Phase 7: admin templates landing. Lives in the
                    // admin surface URL space which sits outside PM's
                    // entryPoint, so it is registered here rather than
                    // in config/Router.bx.
                    { path : "/agent/admin/pm/templates", verbs : "GET", module : "tesserabx-pm", handler : "admin.Templates", action : "index" },

                    // REST API — Projects.
                    { path : "/api/v1/pm/projects",              verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Projects", action : "index"   },
                    { path : "/api/v1/pm/projects",              verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Projects", action : "create"  },
                    { path : "/api/v1/pm/projects/:id",          verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Projects", action : "show"    },
                    { path : "/api/v1/pm/projects/:id",          verbs : "PATCH",  module : "tesserabx-pm", handler : "api.v1.Projects", action : "update"  },
                    { path : "/api/v1/pm/projects/:id",          verbs : "DELETE", module : "tesserabx-pm", handler : "api.v1.Projects", action : "remove"  },
                    { path : "/api/v1/pm/projects/:id/archive",  verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Projects", action : "archive" },
                    { path : "/api/v1/pm/projects/:id/restore",  verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Projects", action : "restore" },

                    // REST API — Tasks.
                    { path : "/api/v1/pm/projects/:projectId/tasks", verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Tasks", action : "index"  },
                    { path : "/api/v1/pm/projects/:projectId/tasks", verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Tasks", action : "create" },
                    { path : "/api/v1/pm/tasks/:id",                 verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Tasks", action : "show"   },
                    { path : "/api/v1/pm/tasks/:id",                 verbs : "PATCH",  module : "tesserabx-pm", handler : "api.v1.Tasks", action : "update" },
                    { path : "/api/v1/pm/tasks/:id",                 verbs : "DELETE", module : "tesserabx-pm", handler : "api.v1.Tasks", action : "remove" },

                    // REST API — Subtasks.
                    { path : "/api/v1/pm/tasks/:taskId/subtasks", verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "index"  },
                    { path : "/api/v1/pm/tasks/:taskId/subtasks", verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "create" },
                    { path : "/api/v1/pm/subtasks/:id",           verbs : "PATCH",  module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "update" },
                    { path : "/api/v1/pm/subtasks/:id",           verbs : "DELETE", module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "remove" }
                    // Note: /agent/pm/time-reports is owned by PM's
                    // own module Router (entryPoint=agent/pm), so it
                    // is NOT declared as a routeClaim.
                ],
                navigation : [
                    {
                        id                 : "pm.agent.main",
                        surface            : "agent",
                        menu               : "main",
                        label              : "Projects",
                        route              : "/agent/pm",
                        icon               : "bi bi-kanban",
                        sortWeight         : 200,
                        requiresAuth       : true,
                        requiredPermission : "pm.view"
                    },
                    {
                        id                 : "pm.portal.main",
                        surface            : "portal",
                        menu               : "main",
                        label              : "Projects",
                        route              : "/pm",
                        icon               : "bi bi-kanban",
                        sortWeight         : 200,
                        requiresAuth       : true,
                        requiredPermission : "pm.view"
                    },
                    // Phase 5: secondary nav entry for the time-
                    // reports page.
                    {
                        id                 : "pm.agent.time-reports",
                        surface            : "agent",
                        menu               : "main",
                        label              : "Time reports",
                        route              : "/agent/pm/time-reports",
                        icon               : "bi bi-stopwatch",
                        sortWeight         : 210,
                        requiresAuth       : true,
                        requiredPermission : "pm.view"
                    }
                ],
                adminPages : [
                    {
                        id                 : "pm.admin.landing",
                        title              : "Project Management",
                        description        : "Configure PM templates, custom fields, and per-tenant settings.",
                        route              : "/agent/admin/pm",
                        icon               : "bi bi-kanban",
                        sortWeight         : 600,
                        requiredPermission : "pm.admin"
                    },
                    // Phase 7: project templates admin (snapshot + hydrate).
                    {
                        id                 : "pm.admin.templates",
                        title              : "PM Templates",
                        description        : "Manage project templates: snapshot from existing projects, edit, share, delete.",
                        route              : "/agent/admin/pm/templates",
                        icon               : "bi bi-file-earmark-text",
                        sortWeight         : 610,
                        requiredPermission : "pm.admin"
                    }
                ],
                settings : [
                    {
                        key         : "pm.default-template-id",
                        type        : "string",
                        label       : "Default project template",
                        description : "Optional template to apply on project creation. Blank uses the shared Standard Workflow template.",
                        default     : "",
                        secret      : false,
                        perTenant   : true
                    }
                ],

                // REST API catalog. Companion to the /api/v1/pm/*
                // route claims above; cbswagger and the admin
                // diagnostics page read this list to build the
                // OpenAPI doc and the per-add-on route inventory.
                apiResources : [
                    // Projects.
                    { id : "pm.projects.list",     method : "GET",    path : "/api/v1/pm/projects",                version : "v1", handler : "api.v1.Projects", action : "index",   summary : "List PM projects.",                  requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.projects.create",   method : "POST",   path : "/api/v1/pm/projects",                version : "v1", handler : "api.v1.Projects", action : "create",  summary : "Create a PM project.",               requiresAuth : true, requiredPermission : "pm.create" },
                    { id : "pm.projects.show",     method : "GET",    path : "/api/v1/pm/projects/:id",            version : "v1", handler : "api.v1.Projects", action : "show",    summary : "Show a single PM project.",          requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.projects.update",   method : "PATCH",  path : "/api/v1/pm/projects/:id",            version : "v1", handler : "api.v1.Projects", action : "update",  summary : "Update an existing PM project.",     requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.projects.delete",   method : "DELETE", path : "/api/v1/pm/projects/:id",            version : "v1", handler : "api.v1.Projects", action : "remove",  summary : "Soft-delete a PM project.",          requiresAuth : true, requiredPermission : "pm.delete" },
                    { id : "pm.projects.archive",  method : "POST",   path : "/api/v1/pm/projects/:id/archive",    version : "v1", handler : "api.v1.Projects", action : "archive", summary : "Archive a PM project.",              requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.projects.restore",  method : "POST",   path : "/api/v1/pm/projects/:id/restore",    version : "v1", handler : "api.v1.Projects", action : "restore", summary : "Restore an archived / soft-deleted PM project.", requiresAuth : true, requiredPermission : "pm.edit" },

                    // Tasks.
                    { id : "pm.tasks.list",        method : "GET",    path : "/api/v1/pm/projects/:projectId/tasks", version : "v1", handler : "api.v1.Tasks",  action : "index",  summary : "List PM tasks within a project.",   requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.tasks.create",      method : "POST",   path : "/api/v1/pm/projects/:projectId/tasks", version : "v1", handler : "api.v1.Tasks",  action : "create", summary : "Create a PM task within a project.", requiresAuth : true, requiredPermission : "pm.create" },
                    { id : "pm.tasks.show",        method : "GET",    path : "/api/v1/pm/tasks/:id",               version : "v1", handler : "api.v1.Tasks",  action : "show",   summary : "Show a single PM task.",             requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.tasks.update",      method : "PATCH",  path : "/api/v1/pm/tasks/:id",               version : "v1", handler : "api.v1.Tasks",  action : "update", summary : "Update an existing PM task.",        requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.tasks.delete",      method : "DELETE", path : "/api/v1/pm/tasks/:id",               version : "v1", handler : "api.v1.Tasks",  action : "remove", summary : "Soft-delete a PM task.",             requiresAuth : true, requiredPermission : "pm.delete" },

                    // Subtasks.
                    { id : "pm.subtasks.list",     method : "GET",    path : "/api/v1/pm/tasks/:taskId/subtasks",  version : "v1", handler : "api.v1.Subtasks", action : "index",  summary : "List PM subtasks within a task.",   requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.subtasks.create",   method : "POST",   path : "/api/v1/pm/tasks/:taskId/subtasks",  version : "v1", handler : "api.v1.Subtasks", action : "create", summary : "Create a PM subtask within a task.", requiresAuth : true, requiredPermission : "pm.create" },
                    { id : "pm.subtasks.update",   method : "PATCH",  path : "/api/v1/pm/subtasks/:id",            version : "v1", handler : "api.v1.Subtasks", action : "update", summary : "Update an existing PM subtask.",     requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.subtasks.delete",   method : "DELETE", path : "/api/v1/pm/subtasks/:id",            version : "v1", handler : "api.v1.Subtasks", action : "remove", summary : "Soft-delete a PM subtask.",          requiresAuth : true, requiredPermission : "pm.delete" }
                ],

                // Phase 4b: audit event types written to AuditService
                // for compliance. ProjectService writes project_created /
                // project_archived / project_deleted inline; TaskService
                // writes task_assigned_to_contact when an assignee lands
                // on a Contact account. template_applied is declared so
                // the dropdown surfaces it ahead of Phase 7's
                // TemplateService, even though no PM code fires it yet.
                auditEvents : [
                    { type : "tesserabx-pm.project_created",          label : "PM: project created",            severity : "info"    },
                    { type : "tesserabx-pm.project_archived",         label : "PM: project archived",           severity : "info"    },
                    { type : "tesserabx-pm.project_deleted",          label : "PM: project deleted",            severity : "warning" },
                    { type : "tesserabx-pm.task_assigned_to_contact", label : "PM: task assigned to a contact", severity : "info"    },
                    { type : "tesserabx-pm.template_applied",         label : "PM: template applied",           severity : "info"    }
                ],
                // Outbound webhook event keys PM announces through
                // EventPayloadBuilder@core. Phase 4a ships the
                // comment-side declarations and the task/project
                // events already firing from Phase 2+; Phase 4b adds
                // the remaining lifecycle keys when the
                // ProjectEventLogger interceptor lands.
                webhookEvents : [
                    { key : "tesserabx-pm.project_created",      label : "PM project created" },
                    { key : "tesserabx-pm.project_archived",     label : "PM project archived" },
                    { key : "tesserabx-pm.task_created",         label : "PM task created" },
                    { key : "tesserabx-pm.task_assigned",        label : "PM task assigned" },
                    { key : "tesserabx-pm.task_status_changed",  label : "PM task status changed" },
                    { key : "tesserabx-pm.task_completed",       label : "PM task completed" },
                    { key : "tesserabx-pm.subtask_created",      label : "PM subtask created" },
                    { key : "tesserabx-pm.subtask_completed",    label : "PM subtask completed" },
                    { key : "tesserabx-pm.comment_added",        label : "PM comment added" },
                    // Phase 8b: bidirectional link lifecycle. Fired
                    // (sync) by TaskTicketService.link / unlink.
                    { key : "tesserabx-pm.ticket_linked",        label : "Ticket linked to a PM task" },
                    { key : "tesserabx-pm.ticket_unlinked",      label : "Ticket unlinked from a PM task" },
                    // Phase 9a: mention dispatched as a webhook
                    // event so external systems can react to @-mentions.
                    { key : "tesserabx-pm.mentioned",            label : "PM mention" }
                ],

                // Phase 8a: bidirectional ticket integration. The
                // host's TicketPanelRegistry renders this partial on
                // ticket detail with `args = { ticket : <entity> }`;
                // PM's TaskTicketService walks the pm_task_tickets
                // join to populate the list. Edits happen on the PM
                // task detail (TaskTicketLink wire); this panel is
                // read-only.
                ticketPanels : [
                    {
                        id                 : "pm.linkedTasks",
                        position           : "right",
                        label              : "Linked PM tasks",
                        partial            : "panels/linked_tasks",
                        module             : "tesserabx-pm",
                        sortWeight         : 500,
                        requiredPermission : "pm.view",
                        defaultCollapsed   : false
                    }
                ],
                // Phase 8b: automation action. Registered via
                // ActionRegistry@automation; the rule editor renders
                // the parameterSchema. parameterSchema sticks to a
                // single `name : "value"` descriptor per the storage
                // note in EXTENSIONS.md - the rule editor's action
                // form persists `{ type, value }`.
                automationActions : [
                    {
                        id              : "tesserabx-pm.createTaskFromTicket",
                        label           : "Create a PM task from this ticket",
                        description     : "Creates a new PM task seeded from the ticket subject + description and links it back to the ticket with a 'fixes' relation.",
                        executor        : "CreateTaskFromTicketExecutor@tesserabx-pm",
                        parameterSchema : [
                            {
                                name        : "value",
                                label       : "Project",
                                type        : "string",
                                required    : true,
                                placeholder : "PM project UUID",
                                description : "UUID of the PM project the task should land in. A dropdown lands once the rule editor's action form supports dynamic option providers."
                            }
                        ]
                    }
                ],
                automationTriggers      : [],

                // Phase 9a: notification templates. Keyed on the
                // (eventKey, channel, recipientType) tuple per
                // EXTENSIONS.md. PM declares inapp + email defaults
                // for both account families across every PM lifecycle
                // event a user cares about; admins override via the
                // notification_templates DB table at runtime.
                //
                // {{appBaseUrl}} and {{unsubscribeUrl}} are injected
                // by the dispatcher; everything else comes from the
                // context struct PmNotificationDispatcher builds.
                // Renderer is a simple {{key}} substitution loop
                // (no conditional helpers); missing keys render as
                // an empty string, so each template is written to
                // read cleanly even with sparse context.
                notificationTemplates : [
                    // ----- task assigned -----
                    {
                        eventKey : "tesserabx-pm.task_assigned", channel : "inapp", recipientType : "agent",
                        titleTemplate : "{{actorLabel}} assigned you {{taskTitle}}",
                        bodyTemplate  : "Project {{projectName}}. Due {{dueDate}}.",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "dueDate", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.task_assigned", channel : "email", recipientType : "agent",
                        titleTemplate : "[PM] {{taskTitle}} assigned to you",
                        bodyTemplate  : "{{actorLabel}} assigned you the task {{taskTitle}} in project {{projectName}}. Open the task: {{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.task_assigned", channel : "inapp", recipientType : "contact",
                        titleTemplate : "You have a new task: {{taskTitle}}",
                        bodyTemplate  : "Project {{projectName}}. Due {{dueDate}}.",
                        linkTemplate  : "{{appBaseUrl}}/pm/tasks/{{taskId}}",
                        placeholders  : [ "taskTitle", "projectName", "dueDate", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.task_assigned", channel : "email", recipientType : "contact",
                        titleTemplate : "[PM] {{taskTitle}} is on your plate",
                        bodyTemplate  : "{{actorLabel}} assigned you the task {{taskTitle}} in {{projectName}}. Open it: {{appBaseUrl}}/pm/tasks/{{taskId}}",
                        linkTemplate  : "{{appBaseUrl}}/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },

                    // ----- comment added (watcher fan-out) -----
                    {
                        eventKey : "tesserabx-pm.comment_added", channel : "inapp", recipientType : "agent",
                        titleTemplate : "{{actorLabel}} commented on {{taskTitle}}",
                        bodyTemplate  : "Project {{projectName}}.",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.comment_added", channel : "email", recipientType : "agent",
                        titleTemplate : "[PM] New comment on {{taskTitle}}",
                        bodyTemplate  : "{{actorLabel}} left a comment on {{taskTitle}} (project {{projectName}}). Read it: {{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.comment_added", channel : "inapp", recipientType : "contact",
                        titleTemplate : "{{actorLabel}} commented on {{taskTitle}}",
                        bodyTemplate  : "Project {{projectName}}.",
                        linkTemplate  : "{{appBaseUrl}}/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.comment_added", channel : "email", recipientType : "contact",
                        titleTemplate : "[PM] New comment on {{taskTitle}}",
                        bodyTemplate  : "{{actorLabel}} left a comment on {{taskTitle}} (project {{projectName}}). Read it: {{appBaseUrl}}/pm/tasks/{{taskId}}",
                        linkTemplate  : "{{appBaseUrl}}/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },

                    // ----- mentioned -----
                    {
                        eventKey : "tesserabx-pm.mentioned", channel : "inapp", recipientType : "agent",
                        titleTemplate : "{{actorLabel}} mentioned you",
                        bodyTemplate  : "On {{taskTitle}} in {{projectName}}.",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.mentioned", channel : "email", recipientType : "agent",
                        titleTemplate : "[PM] {{actorLabel}} mentioned you",
                        bodyTemplate  : "{{actorLabel}} mentioned you in a PM comment on {{taskTitle}} ({{projectName}}). Read it: {{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.mentioned", channel : "inapp", recipientType : "contact",
                        titleTemplate : "{{actorLabel}} mentioned you",
                        bodyTemplate  : "On {{taskTitle}} in {{projectName}}.",
                        linkTemplate  : "{{appBaseUrl}}/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.mentioned", channel : "email", recipientType : "contact",
                        titleTemplate : "[PM] {{actorLabel}} mentioned you",
                        bodyTemplate  : "{{actorLabel}} mentioned you in a PM comment on {{taskTitle}} ({{projectName}}). Read it: {{appBaseUrl}}/pm/tasks/{{taskId}}",
                        linkTemplate  : "{{appBaseUrl}}/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },

                    // ----- task completed (watcher fan-out) -----
                    {
                        eventKey : "tesserabx-pm.task_completed", channel : "inapp", recipientType : "agent",
                        titleTemplate : "{{taskTitle}} marked complete",
                        bodyTemplate  : "{{actorLabel}} closed {{taskTitle}} in {{projectName}}.",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },
                    {
                        eventKey : "tesserabx-pm.task_completed", channel : "email", recipientType : "agent",
                        titleTemplate : "[PM] {{taskTitle}} complete",
                        bodyTemplate  : "{{actorLabel}} marked {{taskTitle}} complete in {{projectName}}. {{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    },

                    // ----- task status changed (watcher fan-out, inapp only to keep email noise down) -----
                    {
                        eventKey : "tesserabx-pm.task_status_changed", channel : "inapp", recipientType : "agent",
                        titleTemplate : "{{taskTitle}} moved",
                        bodyTemplate  : "{{actorLabel}} updated the status of {{taskTitle}} in {{projectName}}.",
                        linkTemplate  : "{{appBaseUrl}}/agent/pm/tasks/{{taskId}}",
                        placeholders  : [ "actorLabel", "taskTitle", "projectName", "taskId" ]
                    }
                ],

                // Phase 5: agent home dashboard widget. The host's
                // dashboard renderer calls dataProvider.dataMethod
                // with the signed-in agent's id and hands the result
                // to the partial as `data`.
                dashboardWidgets : [
                    {
                        id                 : "pm.timeThisWeek",
                        title              : "Time logged this week",
                        partial            : "widgets/time_this_week",
                        module             : "tesserabx-pm",
                        dataProvider       : "TimeTrackingService@tesserabx-pm",
                        dataMethod         : "weeklyForAgent",
                        defaultGridSize    : "col-12 col-md-4",
                        sortWeight         : 600,
                        requiredPermission : "pm.view",
                        zone               : "agent-home"
                    }
                ],
                aiFeatures              : [],
                embeddingConsumers      : [],

                // Per-phase: help content, static assets.
                helpSections            : [],
                helpPages               : [],
                // Static assets registered for the agent surface
                // (board page). The host's AddonAssetService emits
                // <link> / <script> tags into the Agent layout's
                // <head> and pre-</body> slots.
                //
                // SortableJS is vendored under resources/vendor/ so
                // the add-on is self-contained; board.js + board.css
                // are PM's own.
                assets : [
                    { kind : "css", surface : "agent", href : "/modules/tesserabx-pm/resources/css/board.css",                       sortWeight : 500 },
                    { kind : "js",  surface : "agent", src  : "/modules/tesserabx-pm/resources/vendor/sortablejs-1.15.6/Sortable.min.js", sortWeight : 400 },
                    { kind : "js",  surface : "agent", src  : "/modules/tesserabx-pm/resources/js/board.js",                          sortWeight : 500, defer : true }
                ]
            }
        };

        variables.routes              = [];
        // Custom interception points PM announces. Listeners (PM's
        // own ProjectEventLogger plus any future host modules and
        // third-party add-ons) only auto-register if the point is
        // declared up-front. The shape mirrors modules_app/tickets/
        // ModuleConfig.bx.
        variables.interceptorSettings = { customInterceptionPoints : [
            "onPmProjectCreated",
            "onPmProjectArchived",
            "onPmTaskCreated",
            "onPmTaskAssigned",
            "onPmTaskStatusChanged",
            "onPmTaskCompleted",
            "onPmSubtaskCreated",
            "onPmSubtaskCompleted",
            "onPmCommentAdded",
            "onPmMentioned",
            // Phase 8b: bidirectional ticket link lifecycle.
            "onPmTicketLinked",
            "onPmTicketUnlinked"
        ] };
        variables.interceptors        = [
            // Phase 4b: appends to pm_project_events for every PM
            // lifecycle event announced by the services. Listens to
            // onPmProjectCreated / onPmProjectArchived /
            // onPmTaskCreated / onPmTaskAssigned /
            // onPmTaskStatusChanged / onPmTaskCompleted /
            // onPmSubtaskCreated / onPmSubtaskCompleted /
            // onPmCommentAdded.
            {
                class      : "#moduleMapping#.interceptors.ProjectEventLogger",
                name       : "ProjectEventLogger",
                properties : {}
            },
            // Phase 8b: observation point for onPmTaskCompleted.
            // The actual close-on-complete prompt is data-driven on
            // the task show page via CloseOnCompletePrompt; this
            // listener writes diagnostic logs and is the attachment
            // point for any future close-on-complete automation.
            {
                class      : "#moduleMapping#.interceptors.PmTaskLifecycleListener",
                name       : "PmTaskLifecycleListener",
                properties : {}
            },
            // Phase 9a: translates PM lifecycle envelopes into
            // NotificationsService.dispatchForEvent calls. The
            // dispatcher resolves recipients (assignee / watchers /
            // mentioned user), builds the template context, and
            // hands off to the host notifications module.
            {
                class      : "#moduleMapping#.interceptors.PmNotificationDispatcher",
                name       : "PmNotificationDispatcher",
                properties : {}
            }
        ];
    }

    function onLoad(){
        // Services (singleton).
        binder.map( "VisibilityService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.VisibilityService" )
              .asSingleton();
        binder.map( "ProjectService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.ProjectService" )
              .asSingleton();
        binder.map( "ProjectStatusService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.ProjectStatusService" )
              .asSingleton();
        binder.map( "BoardService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.BoardService" )
              .asSingleton();
        binder.map( "TaskService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.TaskService" )
              .asSingleton();
        binder.map( "SubtaskService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.SubtaskService" )
              .asSingleton();
        binder.map( "CommentService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.CommentService" )
              .asSingleton();
        binder.map( "MentionService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.MentionService" )
              .asSingleton();
        binder.map( "WatcherService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.WatcherService" )
              .asSingleton();
        binder.map( "ProjectEventService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.ProjectEventService" )
              .asSingleton();
        binder.map( "TimeTrackingService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.TimeTrackingService" )
              .asSingleton();
        binder.map( "LabelService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.LabelService" )
              .asSingleton();
        binder.map( "CustomFieldService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.CustomFieldService" )
              .asSingleton();
        binder.map( "TemplateService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.TemplateService" )
              .asSingleton();
        binder.map( "TaskTicketService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.TaskTicketService" )
              .asSingleton();

        // DTOs (singleton).
        binder.map( "ProjectDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.ProjectDto" )
              .asSingleton();
        binder.map( "TaskDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.TaskDto" )
              .asSingleton();
        binder.map( "SubtaskDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.SubtaskDto" )
              .asSingleton();
        binder.map( "CommentDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.CommentDto" )
              .asSingleton();
        binder.map( "ProjectEventDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.ProjectEventDto" )
              .asSingleton();
        binder.map( "TimeLogDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.TimeLogDto" )
              .asSingleton();
        binder.map( "LabelDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.LabelDto" )
              .asSingleton();
        binder.map( "CustomFieldDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.CustomFieldDto" )
              .asSingleton();
        binder.map( "CustomFieldValueDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.CustomFieldValueDto" )
              .asSingleton();
        binder.map( "TemplateDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.TemplateDto" )
              .asSingleton();
        binder.map( "TaskTicketDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.TaskTicketDto" )
              .asSingleton();

        // Quick entity mappings. autoMapModels is false, so every
        // entity Quick may resolve through a relationship target
        // string like "Project@tesserabx-pm" must be bound here.
        // Mirrors the modules_app/tickets/ModuleConfig.bx pattern:
        // entities are not singletons (each call returns a new
        // instance).
        binder.map( "ProjectTemplate@tesserabx-pm"  ).to( "#moduleMapping#.models.entities.ProjectTemplate"  );
        binder.map( "Project@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Project"          );
        binder.map( "ProjectStatus@tesserabx-pm"    ).to( "#moduleMapping#.models.entities.ProjectStatus"    );
        binder.map( "ProjectMember@tesserabx-pm"    ).to( "#moduleMapping#.models.entities.ProjectMember"    );
        binder.map( "ProjectEvent@tesserabx-pm"     ).to( "#moduleMapping#.models.entities.ProjectEvent"     );
        binder.map( "Label@tesserabx-pm"            ).to( "#moduleMapping#.models.entities.Label"            );
        binder.map( "TaskLabel@tesserabx-pm"        ).to( "#moduleMapping#.models.entities.TaskLabel"        );
        binder.map( "CustomField@tesserabx-pm"      ).to( "#moduleMapping#.models.entities.CustomField"      );
        binder.map( "CustomFieldValue@tesserabx-pm" ).to( "#moduleMapping#.models.entities.CustomFieldValue" );
        binder.map( "Task@tesserabx-pm"             ).to( "#moduleMapping#.models.entities.Task"             );
        binder.map( "Subtask@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Subtask"          );
        binder.map( "TaskTicket@tesserabx-pm"       ).to( "#moduleMapping#.models.entities.TaskTicket"       );
        binder.map( "Comment@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Comment"          );
        binder.map( "Watcher@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Watcher"          );
        binder.map( "Mention@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Mention"          );
        binder.map( "TimeLog@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.TimeLog"          );
        binder.map( "Attachment@tesserabx-pm"       ).to( "#moduleMapping#.models.entities.Attachment"       );
    }

    function onUnload(){}

}

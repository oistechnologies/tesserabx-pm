/**
 * tesserabx-pm: Project Management for TesseraBX.
 *
 * A third-party TesseraBX add-on. Installs as a standard ColdBox 8
 * BoxLang module at modules/tesserabx-pm/ and participates in the
 * host's settings.tesserabx manifest contract documented in the host
 * repo at docs/EXTENSIONS.md.
 *
 * Phase 0 scaffold. The settings.tesserabx block carries the
 * foundation (addonId, displayName, version, version range,
 * requiresAi) and a placeholder for every registry contribution
 * PM will populate as phases land. Empty arrays are intentional;
 * the host's AddonRegistryService accepts them and a phase-by-phase
 * InstallSpec catches any registry that should have grown but did
 * not.
 *
 * Full build plan: docs/BUILD-PLAN.md.
 */
class {

    this.title              = "Project Management";
    this.author             = "OIS Technologies";
    this.webURL             = "https://github.com/oistechnologies/tesserabx-pm";
    this.description        = "Project Management add-on for the TesseraBX helpdesk platform.";
    this.version            = "0.0.1";
    this.viewParentLookup   = true;
    this.layoutParentLookup = true;
    // PM owns the `/agent/pm` URL space directly through its module
    // entryPoint (multi-segment, the same pattern the host's admin
    // module uses with entryPoint="agent/admin"). All PM agent-side
    // routes (Projects, Tasks, Subtasks, ProjectStatuses, etc.)
    // declared in config/Router.bx auto-prefix with /agent/pm; the
    // agent firewall regex `^agent($|/)` covers them automatically.
    //
    // The two cross-surface URLs (`/pm` on the portal and
    // `/agent/admin/pm` on the admin surface) are not reachable from
    // PM's own router because they live outside the entryPoint URL
    // space. They are bound through settings.tesserabx.routeClaims
    // and registered by the host's AddonRouteClaimsRegistrar on
    // afterAspectsLoad.
    this.entryPoint         = "agent/pm";
    this.modelNamespace     = "tesserabx-pm";
    this.cfmapping          = "tesserabx.modules.tesserabx-pm";
    this.autoMapModels      = false;
    this.dependencies       = [ "core", "contacts", "audit", "notifications", "ai", "api", "help" ];

    function configure(){
        variables.settings = {
            tesserabx : {
                // Foundation. minCoreVersion matches the host's
                // current appVersion (0.0.1); maxCoreVersion is
                // omitted so any host >= 0.0.1 accepts PM.
                addonId        : "tesserabx-pm",
                displayName    : "Project Management",
                version        : "0.0.1",
                minCoreVersion : "0.0.1",
                contributesTo  : [
                    "permissions", "roles", "navigation",
                    "adminPages", "settings", "routeClaims"
                ],
                requiresAi     : false,

                // Registry contributions. Each subsequent phase fills
                // the arrays it owns and adds matching probes to the
                // InstallSpec. The set of keys here mirrors the host
                // EXTENSIONS.md registry catalog; missing keys are
                // treated as empty by AddonRegistryService.

                // Phase 1: permissions, roles, navigation, admin
                // landing card, per-tenant settings.
                permissions : [
                    { id : "pm.view",          label : "View PM projects and tasks",            description : "Read PM data within the viewer's organization, subject to Option C visibility." },
                    { id : "pm.create",        label : "Create PM projects and tasks",          description : "Create projects, tasks, and subtasks." },
                    { id : "pm.edit",          label : "Edit PM projects and tasks",            description : "Update projects, tasks, subtasks, comments, labels, and custom field values." },
                    { id : "pm.delete",        label : "Delete PM projects and tasks",          description : "Soft-delete or archive projects, tasks, and subtasks." },
                    { id : "pm.assign-client", label : "Assign tasks to client users",          description : "Assign tasks to contacts (clients), not just agents. Agent-side only." },
                    { id : "pm.admin",         label : "Administer PM",                         description : "Manage templates, project status sets, per-project custom fields, per-tenant PM settings." }
                ],
                roles : [
                    {
                        id          : "pm-admin",
                        label       : "PM Admin",
                        description : "Full PM access including templates, custom fields, and per-tenant settings.",
                        surface     : "agent",
                        permissions : [ "pm.view", "pm.create", "pm.edit", "pm.delete", "pm.assign-client", "pm.admin" ]
                    },
                    {
                        id          : "pm-manager",
                        label       : "PM Manager",
                        description : "Manage projects and tasks; can assign work to clients.",
                        surface     : "agent",
                        permissions : [ "pm.view", "pm.create", "pm.edit", "pm.delete", "pm.assign-client" ]
                    },
                    {
                        id          : "pm-contributor",
                        label       : "PM Contributor",
                        description : "Create and edit projects and tasks; cannot delete or assign to clients.",
                        surface     : "agent",
                        permissions : [ "pm.view", "pm.create", "pm.edit" ]
                    },
                    {
                        id          : "pm-viewer",
                        label       : "PM Viewer",
                        description : "Read-only access to PM projects and tasks.",
                        surface     : "agent",
                        permissions : [ "pm.view" ]
                    },
                    {
                        id          : "pm-client-viewer",
                        label       : "PM Client Viewer",
                        description : "Client-side: read-only access to PM projects shared with their organization.",
                        surface     : "contact",
                        permissions : [ "pm.view" ]
                    },
                    {
                        id          : "pm-client-contributor",
                        label       : "PM Client Contributor",
                        description : "Client-side: read and edit access to PM projects shared with their organization.",
                        surface     : "contact",
                        permissions : [ "pm.view", "pm.edit" ]
                    }
                ],
                // Top-level URL claims for surfaces PM cannot reach
                // from its own module Router. /agent/pm is owned by
                // PM's entryPoint; the cross-surface URLs (portal,
                // admin landing card) and every /api/v1/pm/* REST
                // endpoint are declared here. The host's
                // AddonRouteClaimsRegistrar interceptor walks every
                // manifest's `routeClaims` and prepends each into
                // ColdBox's main router on `afterAspectsLoad`, so
                // claims match before the host's catch-all.
                routeClaims : [
                    // Cross-surface landing URLs.
                    { path : "/pm",             verbs : "GET",    module : "tesserabx-pm", handler : "Main", action : "index" },
                    { path : "/agent/admin/pm", verbs : "GET",    module : "tesserabx-pm", handler : "Main", action : "index" },

                    // REST API — Projects.
                    { path : "/api/v1/pm/projects",              verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Projects", action : "index"   },
                    { path : "/api/v1/pm/projects",              verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Projects", action : "create"  },
                    { path : "/api/v1/pm/projects/:id",          verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Projects", action : "show"    },
                    { path : "/api/v1/pm/projects/:id",          verbs : "PATCH",  module : "tesserabx-pm", handler : "api.v1.Projects", action : "update"  },
                    { path : "/api/v1/pm/projects/:id",          verbs : "DELETE", module : "tesserabx-pm", handler : "api.v1.Projects", action : "remove"  },
                    { path : "/api/v1/pm/projects/:id/archive",  verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Projects", action : "archive" },
                    { path : "/api/v1/pm/projects/:id/restore",  verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Projects", action : "restore" },

                    // REST API — Tasks.
                    { path : "/api/v1/pm/projects/:projectId/tasks", verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Tasks", action : "index"  },
                    { path : "/api/v1/pm/projects/:projectId/tasks", verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Tasks", action : "create" },
                    { path : "/api/v1/pm/tasks/:id",                 verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Tasks", action : "show"   },
                    { path : "/api/v1/pm/tasks/:id",                 verbs : "PATCH",  module : "tesserabx-pm", handler : "api.v1.Tasks", action : "update" },
                    { path : "/api/v1/pm/tasks/:id",                 verbs : "DELETE", module : "tesserabx-pm", handler : "api.v1.Tasks", action : "remove" },

                    // REST API — Subtasks.
                    { path : "/api/v1/pm/tasks/:taskId/subtasks", verbs : "GET",    module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "index"  },
                    { path : "/api/v1/pm/tasks/:taskId/subtasks", verbs : "POST",   module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "create" },
                    { path : "/api/v1/pm/subtasks/:id",           verbs : "PATCH",  module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "update" },
                    { path : "/api/v1/pm/subtasks/:id",           verbs : "DELETE", module : "tesserabx-pm", handler : "api.v1.Subtasks", action : "remove" }
                ],
                navigation : [
                    {
                        id                 : "pm.agent.main",
                        surface            : "agent",
                        menu               : "main",
                        label              : "Projects",
                        route              : "/agent/pm",
                        icon               : "bi bi-kanban",
                        sortWeight         : 200,
                        requiresAuth       : true,
                        requiredPermission : "pm.view"
                    },
                    {
                        id                 : "pm.portal.main",
                        surface            : "portal",
                        menu               : "main",
                        label              : "Projects",
                        route              : "/pm",
                        icon               : "bi bi-kanban",
                        sortWeight         : 200,
                        requiresAuth       : true,
                        requiredPermission : "pm.view"
                    }
                ],
                adminPages : [
                    {
                        id                 : "pm.admin.landing",
                        title              : "Project Management",
                        description        : "Configure PM templates, custom fields, and per-tenant settings.",
                        route              : "/agent/admin/pm",
                        icon               : "bi bi-kanban",
                        sortWeight         : 600,
                        requiredPermission : "pm.admin"
                    }
                ],
                settings : [
                    {
                        key         : "pm.default-template-id",
                        type        : "string",
                        label       : "Default project template",
                        description : "Optional template to apply on project creation. Blank uses the shared Standard Workflow template.",
                        default     : "",
                        secret      : false,
                        perTenant   : true
                    }
                ],

                // REST API catalog. Companion to the /api/v1/pm/*
                // route claims above; cbswagger and the admin
                // diagnostics page read this list to build the
                // OpenAPI doc and the per-add-on route inventory.
                apiResources : [
                    // Projects.
                    { id : "pm.projects.list",     method : "GET",    path : "/api/v1/pm/projects",                version : "v1", handler : "api.v1.Projects", action : "index",   summary : "List PM projects.",                  requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.projects.create",   method : "POST",   path : "/api/v1/pm/projects",                version : "v1", handler : "api.v1.Projects", action : "create",  summary : "Create a PM project.",               requiresAuth : true, requiredPermission : "pm.create" },
                    { id : "pm.projects.show",     method : "GET",    path : "/api/v1/pm/projects/:id",            version : "v1", handler : "api.v1.Projects", action : "show",    summary : "Show a single PM project.",          requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.projects.update",   method : "PATCH",  path : "/api/v1/pm/projects/:id",            version : "v1", handler : "api.v1.Projects", action : "update",  summary : "Update an existing PM project.",     requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.projects.delete",   method : "DELETE", path : "/api/v1/pm/projects/:id",            version : "v1", handler : "api.v1.Projects", action : "remove",  summary : "Soft-delete a PM project.",          requiresAuth : true, requiredPermission : "pm.delete" },
                    { id : "pm.projects.archive",  method : "POST",   path : "/api/v1/pm/projects/:id/archive",    version : "v1", handler : "api.v1.Projects", action : "archive", summary : "Archive a PM project.",              requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.projects.restore",  method : "POST",   path : "/api/v1/pm/projects/:id/restore",    version : "v1", handler : "api.v1.Projects", action : "restore", summary : "Restore an archived / soft-deleted PM project.", requiresAuth : true, requiredPermission : "pm.edit" },

                    // Tasks.
                    { id : "pm.tasks.list",        method : "GET",    path : "/api/v1/pm/projects/:projectId/tasks", version : "v1", handler : "api.v1.Tasks",  action : "index",  summary : "List PM tasks within a project.",   requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.tasks.create",      method : "POST",   path : "/api/v1/pm/projects/:projectId/tasks", version : "v1", handler : "api.v1.Tasks",  action : "create", summary : "Create a PM task within a project.", requiresAuth : true, requiredPermission : "pm.create" },
                    { id : "pm.tasks.show",        method : "GET",    path : "/api/v1/pm/tasks/:id",               version : "v1", handler : "api.v1.Tasks",  action : "show",   summary : "Show a single PM task.",             requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.tasks.update",      method : "PATCH",  path : "/api/v1/pm/tasks/:id",               version : "v1", handler : "api.v1.Tasks",  action : "update", summary : "Update an existing PM task.",        requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.tasks.delete",      method : "DELETE", path : "/api/v1/pm/tasks/:id",               version : "v1", handler : "api.v1.Tasks",  action : "remove", summary : "Soft-delete a PM task.",             requiresAuth : true, requiredPermission : "pm.delete" },

                    // Subtasks.
                    { id : "pm.subtasks.list",     method : "GET",    path : "/api/v1/pm/tasks/:taskId/subtasks",  version : "v1", handler : "api.v1.Subtasks", action : "index",  summary : "List PM subtasks within a task.",   requiresAuth : true, requiredPermission : "pm.view"   },
                    { id : "pm.subtasks.create",   method : "POST",   path : "/api/v1/pm/tasks/:taskId/subtasks",  version : "v1", handler : "api.v1.Subtasks", action : "create", summary : "Create a PM subtask within a task.", requiresAuth : true, requiredPermission : "pm.create" },
                    { id : "pm.subtasks.update",   method : "PATCH",  path : "/api/v1/pm/subtasks/:id",            version : "v1", handler : "api.v1.Subtasks", action : "update", summary : "Update an existing PM subtask.",     requiresAuth : true, requiredPermission : "pm.edit"   },
                    { id : "pm.subtasks.delete",   method : "DELETE", path : "/api/v1/pm/subtasks/:id",            version : "v1", handler : "api.v1.Subtasks", action : "remove", summary : "Soft-delete a PM subtask.",          requiresAuth : true, requiredPermission : "pm.delete" }
                ],

                // Phase 4: audit event types, project event timeline,
                // and the canonical event envelopes PM announces.
                auditEvents             : [],
                webhookEvents           : [],

                // Phase 8: bidirectional ticket integration.
                ticketPanels            : [],
                automationActions       : [],
                automationTriggers      : [],

                // Phase 9: notification delivery (PM emits events
                // that the host notifications module consumes; PM
                // declares the templates).
                notificationTemplates   : [],

                // Phases 3, 5, 12: dashboard widgets and AI features.
                dashboardWidgets        : [],
                aiFeatures              : [],
                embeddingConsumers      : [],

                // Per-phase: help content, static assets.
                helpSections            : [],
                helpPages               : [],
                assets                  : []
            }
        };

        variables.routes              = [];
        variables.interceptorSettings = { customInterceptionPoints : [] };
        variables.interceptors        = [];
    }

    function onLoad(){
        // Services (singleton).
        binder.map( "VisibilityService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.VisibilityService" )
              .asSingleton();
        binder.map( "ProjectService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.ProjectService" )
              .asSingleton();
        binder.map( "ProjectStatusService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.ProjectStatusService" )
              .asSingleton();
        binder.map( "BoardService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.BoardService" )
              .asSingleton();
        binder.map( "TaskService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.TaskService" )
              .asSingleton();
        binder.map( "SubtaskService@tesserabx-pm" )
              .to( "#moduleMapping#.models.services.SubtaskService" )
              .asSingleton();

        // DTOs (singleton).
        binder.map( "ProjectDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.ProjectDto" )
              .asSingleton();
        binder.map( "TaskDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.TaskDto" )
              .asSingleton();
        binder.map( "SubtaskDto@tesserabx-pm" )
              .to( "#moduleMapping#.models.dtos.SubtaskDto" )
              .asSingleton();

        // Quick entity mappings. autoMapModels is false, so every
        // entity Quick may resolve through a relationship target
        // string like "Project@tesserabx-pm" must be bound here.
        // Mirrors the modules_app/tickets/ModuleConfig.bx pattern:
        // entities are not singletons (each call returns a new
        // instance).
        binder.map( "ProjectTemplate@tesserabx-pm"  ).to( "#moduleMapping#.models.entities.ProjectTemplate"  );
        binder.map( "Project@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Project"          );
        binder.map( "ProjectStatus@tesserabx-pm"    ).to( "#moduleMapping#.models.entities.ProjectStatus"    );
        binder.map( "ProjectMember@tesserabx-pm"    ).to( "#moduleMapping#.models.entities.ProjectMember"    );
        binder.map( "ProjectEvent@tesserabx-pm"     ).to( "#moduleMapping#.models.entities.ProjectEvent"     );
        binder.map( "Label@tesserabx-pm"            ).to( "#moduleMapping#.models.entities.Label"            );
        binder.map( "TaskLabel@tesserabx-pm"        ).to( "#moduleMapping#.models.entities.TaskLabel"        );
        binder.map( "CustomField@tesserabx-pm"      ).to( "#moduleMapping#.models.entities.CustomField"      );
        binder.map( "CustomFieldValue@tesserabx-pm" ).to( "#moduleMapping#.models.entities.CustomFieldValue" );
        binder.map( "Task@tesserabx-pm"             ).to( "#moduleMapping#.models.entities.Task"             );
        binder.map( "Subtask@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Subtask"          );
        binder.map( "TaskTicket@tesserabx-pm"       ).to( "#moduleMapping#.models.entities.TaskTicket"       );
        binder.map( "Comment@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Comment"          );
        binder.map( "Watcher@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Watcher"          );
        binder.map( "Mention@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.Mention"          );
        binder.map( "TimeLog@tesserabx-pm"          ).to( "#moduleMapping#.models.entities.TimeLog"          );
        binder.map( "Attachment@tesserabx-pm"       ).to( "#moduleMapping#.models.entities.Attachment"       );
    }

    function onUnload(){}

}

/**
 * api.v1.Projects — REST endpoints for PM project CRUD.
 *
 * Mounted at /api/v1/pm/projects/* via settings.tesserabx.routeClaims.
 * Routes (HTTP method -> action):
 *
 *   GET    /api/v1/pm/projects               -> index
 *   POST   /api/v1/pm/projects               -> create
 *   GET    /api/v1/pm/projects/:id           -> show
 *   PATCH  /api/v1/pm/projects/:id           -> update
 *   POST   /api/v1/pm/projects/:id/archive   -> archive
 *   POST   /api/v1/pm/projects/:id/restore   -> restore
 *   DELETE /api/v1/pm/projects/:id           -> remove
 *
 * Every action calls ensureAgent() first: the host's main cbSecurity
 * firewall does not cover /api/*, so the JWT check lives per-action.
 * Pattern mirrors modules_app/api/handlers/Tickets.bx in the host.
 */
class {

    property name="projectService" inject="ProjectService@tesserabx-pm";
    property name="projectDto"     inject="ProjectDto@tesserabx-pm";
    property name="jwtService"     inject="JwtService@cbsecurity";

    function preHandler( event, rc, prc, action, eventArguments ){
        event.paramValue( "format", "json" );
    }

    // ---- Reads

    function index( event, rc, prc ){
        if ( !ensureAgent( event, prc ) ) return;
        param rc.organizationId  = "";
        param rc.lifecycleStatus = "";
        param rc.q               = "";
        param rc.includeArchived = false;
        param rc.limit           = 100;
        param rc.offset          = 0;

        var rows = projectService.listProjects(
            organizationId  = rc.organizationId,
            lifecycleStatus = rc.lifecycleStatus,
            search          = rc.q,
            includeArchived = truthy( rc.includeArchived ),
            limit           = int( min( val( rc.limit ), 200 ) ),
            offset          = int( max( val( rc.offset ), 0 ) )
        );
        return event.renderData(
            type       = "json",
            statusCode = 200,
            data       = { projects : projectDto.fromProjectArray( rows ), total : rows.len() }
        );
    }

    function show( event, rc, prc ){
        if ( !ensureAgent( event, prc ) ) return;
        var p = projectService.getProject( rc.id ?: "" );
        if ( isNull( p ) ) return notFound( event, "Project not found." );
        return event.renderData( type = "json", statusCode = 200, data = projectDto.fromProject( p ) );
    }

    // ---- Writes

    function create( event, rc, prc ){
        if ( !ensureAgent( event, prc ) ) return;
        param rc.name            = "";
        param rc.description     = "";
        param rc.organizationId  = "";
        param rc.visibilityScope = "all_org_members";
        param rc.startDate       = "";
        param rc.endDate         = "";
        param rc.timeTrackingEnabled = false;

        try {
            var p = projectService.createProject( {
                organizationId      : rc.organizationId,
                name                : rc.name,
                description         : rc.description,
                visibilityScope     : rc.visibilityScope,
                startDate           : len( rc.startDate ) ? rc.startDate : javaCast( "null", "" ),
                endDate             : len( rc.endDate )   ? rc.endDate   : javaCast( "null", "" ),
                timeTrackingEnabled : truthy( rc.timeTrackingEnabled ),
                actorType           : "agent",
                actorId             : currentAgentId( prc )
            } );
            return event.renderData(
                type       = "json",
                statusCode = 201,
                data       = projectDto.fromProject( p )
            );
        } catch ( any e ) {
            return badRequest( event, e.message );
        }
    }

    function update( event, rc, prc ){
        if ( !ensureAgent( event, prc ) ) return;
        if ( isNull( projectService.getProject( rc.id ?: "" ) ) ) {
            return notFound( event, "Project not found." );
        }

        // Only apply fields the caller supplied. PATCH semantics:
        // missing keys leave the column alone.
        var patch = collectUpdatePatch( rc );
        patch.actorType = "agent";
        patch.actorId   = currentAgentId( prc );

        try {
            var p = projectService.updateProject( rc.id, patch );
            return event.renderData( type = "json", statusCode = 200, data = projectDto.fromProject( p ) );
        } catch ( any e ) {
            return badRequest( event, e.message );
        }
    }

    function archive( event, rc, prc ){
        if ( !ensureAgent( event, prc ) ) return;
        try {
            var p = projectService.archiveProject( rc.id ?: "", {
                actorType : "agent", actorId : currentAgentId( prc )
            } );
            return event.renderData( type = "json", statusCode = 200, data = projectDto.fromProject( p ) );
        } catch ( any e ) {
            if ( e.type contains "UnknownProject" ) return notFound( event, e.message );
            return badRequest( event, e.message );
        }
    }

    function restore( event, rc, prc ){
        if ( !ensureAgent( event, prc ) ) return;
        try {
            var p = projectService.restoreProject( rc.id ?: "", {
                actorType : "agent", actorId : currentAgentId( prc )
            } );
            return event.renderData( type = "json", statusCode = 200, data = projectDto.fromProject( p ) );
        } catch ( any e ) {
            if ( e.type contains "UnknownProject" ) return notFound( event, e.message );
            return badRequest( event, e.message );
        }
    }

    function remove( event, rc, prc ){
        if ( !ensureAgent( event, prc ) ) return;
        try {
            projectService.removeProject( rc.id ?: "", {
                actorType : "agent", actorId : currentAgentId( prc )
            } );
            return event.renderData( type = "json", statusCode = 204, data = "" );
        } catch ( any e ) {
            if ( e.type contains "UnknownProject" ) return notFound( event, e.message );
            return badRequest( event, e.message );
        }
    }

    // ---- internals

    private boolean function ensureAgent( required any event, required struct prc ){
        try {
            var payload = jwtService.getPayload();
        } catch ( any e ) {
            arguments.event.renderData(
                type = "json", statusCode = 401,
                data = { error : ( e.type ?: "TokenError" ) & ": " & ( e.message ?: "" ) }
            );
            return false;
        }
        if ( !listFindNoCase( payload.scope ?: "", "agent", " " ) ) {
            arguments.event.renderData(
                type = "json", statusCode = 403,
                data = { error : "Token does not carry the agent role." }
            );
            return false;
        }
        return true;
    }

    private string function currentAgentId( required struct prc ){
        if ( !structKeyExists( arguments.prc, "oCurrentUser" ) ) return "";
        var u = arguments.prc.oCurrentUser;
        if ( isNull( u ) ) return "";
        try { return u.getId(); } catch ( any e ) { return ""; }
    }

    private struct function collectUpdatePatch( required struct rc ){
        var patch = {};
        for ( var key in [ "name", "description", "visibilityScope", "lifecycleStatus",
                           "startDate", "endDate", "timeTrackingEnabled" ] ) {
            if ( structKeyExists( arguments.rc, key ) ) {
                patch[ key ] = ( key == "timeTrackingEnabled" )
                    ? truthy( arguments.rc[ key ] )
                    : arguments.rc[ key ];
            }
        }
        return patch;
    }

    private boolean function truthy( required any v ){
        if ( isBoolean( arguments.v ) ) return arguments.v;
        var s = lCase( toString( arguments.v ?: "" ) );
        return s == "true" || s == "1" || s == "on" || s == "yes";
    }

    private any function badRequest( required any event, required string message ){
        return arguments.event.renderData( type = "json", statusCode = 400, data = { error : arguments.message } );
    }

    private any function notFound( required any event, required string message ){
        return arguments.event.renderData( type = "json", statusCode = 404, data = { error : arguments.message } );
    }

}

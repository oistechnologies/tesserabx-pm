/**
 * Phase 0 placeholder handler.
 *
 * Renders a "PM installed" confirmation page at the module entry
 * point so an operator (or the Phase 0 acceptance walk) can verify
 * the add-on is bind-mounted, discovered, and routable. Replaced by
 * the real project/task handlers in Phase 2.
 *
 * Bypasses the host layout chain. PM has not yet wired itself into
 * the host's Agent layout (that happens in Phase 1 with the
 * permission and navigation contributions) and the placeholder is
 * intentionally stand-alone so a sysadmin can hit it without an
 * authenticated session.
 */
class {

    function index( event, rc, prc ){
        prc.pageTitle = "Project Management installed";
        event.setView( view = "main/installed", module = "tesserabx-pm", noLayout = true );
    }

}

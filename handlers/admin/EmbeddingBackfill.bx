/**
 * Admin EmbeddingBackfill handler. One-shot trigger for the host's
 * EmbeddingScheduler so an operator can index every PM task whose
 * embedding column is still NULL without waiting for the next
 * hourly sweep tick (Phase 12a).
 *
 * The host's `ai:embedding-sweep` scheduled task is the steady-state
 * cadence; this endpoint exists for the post-install / post-import
 * backlog where waiting an hour is silly.
 *
 * Surface: POST /agent/admin/pm/embed-backlog. Mounted via the
 * settings.tesserabx.routeClaims entry in ModuleConfig because the
 * admin URL space sits outside PM's `agent/pm` entryPoint.
 *
 * Access control: pm.admin (the same gate as every other PM admin
 * surface).
 *
 * AI-off: when AI_ENABLED=false, the host's EmbeddingScheduler walks
 * the consumers but each consumer's AiMiddleware.embed call returns
 * the "disabled" outcome, so nothing is written. The report we return
 * reflects that (errored = N, indexed = 0). PM does not duplicate the
 * isEnabled check here; the host owns the gating.
 */
class {

    property name="wirebox"    inject="wirebox";
    property name="messagebox" inject="messagebox@cbmessagebox";

    function preHandler( event, rc, prc, action, eventArguments ){
        event.setLayout( name = "Agent", module = "core" );
    }

    /**
     * POST. Triggers EmbeddingScheduler.runOnce() and renders the
     * per-consumer report as JSON. Operators can curl this or hit it
     * via an admin button (button lands with the dashboard widget
     * in Phase 12b).
     *
     * Body params:
     *   - limit (numeric, default 200): max entities per consumer per run.
     *     The default is intentionally higher than the host's hourly
     *     tick (25) because the operator is asking for this explicitly.
     */
    function run( event, rc, prc ){
        var limit     = val( rc.limit ?: 200 );
        if ( limit < 1 ) limit = 200;
        var scheduler = wirebox.getInstance( "EmbeddingScheduler@ai" );
        var report    = scheduler.runOnce( perConsumerLimit : limit );
        event.renderData( type : "json", data : report );
    }

    /**
     * Admin-UI variant of `run`. Triggers the same scheduler sweep
     * but messageboxes the per-consumer summary and relocates back
     * to the PM admin landing so an operator who clicked the "Run
     * backfill now" button gets a human-friendly result instead of
     * raw JSON. Phase 13a polish.
     */
    function runUi( event, rc, prc ){
        var limit     = val( rc.limit ?: 200 );
        if ( limit < 1 ) limit = 200;
        try {
            var scheduler = wirebox.getInstance( "EmbeddingScheduler@ai" );
            var report    = scheduler.runOnce( perConsumerLimit : limit );

            var pmLine = "";
            for ( var c in ( report.consumers ?: [] ) ) {
                if ( ( c.id ?: "" ) == "tesserabx-pm.task" ) {
                    pmLine = " PM tasks indexed: " & val( c.indexed ?: 0 ) & " (" & val( c.errored ?: 0 ) & " errors).";
                    break;
                }
            }
            messagebox.info(
                "Embedding sweep complete. "
                & "Total indexed: " & val( report.totalIndexed ?: 0 ) & "."
                & pmLine
                & " Duration: " & val( report.durationMs ?: 0 ) & "ms."
            );
        } catch ( any e ) {
            messagebox.error( "Backfill failed: " & e.message );
        }
        relocate( uri = "/agent/admin/pm" );
    }

}

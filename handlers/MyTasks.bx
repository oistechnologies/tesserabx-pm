/**
 * Agent-surface MyTasks handler. Single action mounts the MyTasks
 * CBWire.
 *
 * Route: /agent/pm/my-tasks
 */
class {

    function preHandler( event, rc, prc, action, eventArguments ){
        event.setLayout( name = "Agent", module = "core" );
    }

    function index( event, rc, prc ){
        prc.pageTitle = "My tasks";
        event.setView( view = "myTasks/index", module = "tesserabx-pm" );
    }

}

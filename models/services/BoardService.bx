/**
 * BoardService: groups tasks by project status into the kanban
 * column model the board view consumes.
 *
 * Phase 3a ships the server-side grouping + filter pipeline. The
 * CBWire layer in Phase 3b (KanbanBoard, TaskCard, TaskDetail
 * components) calls this service the same way; the only thing
 * that changes between phases is the rendering surface.
 *
 * The service does NOT enforce permissions or Option C visibility
 * by itself. Callers route reads through VisibilityService when
 * the viewer might be a contact; agent-side calls bypass the
 * tenant scope automatically because TaskService.listForProject
 * already does so (the kanban surface is agent-facing at Phase 3a;
 * the contact-facing project board lands in Phase 11).
 *
 * Public shape:
 *
 *   var board = boardService.buildBoard(
 *       projectId : "<uuid>",
 *       filters   : {
 *           statusId     : "",   // optional pin to one column
 *           assigneeType : "",   // "agent" | "contact"
 *           assigneeId   : "",
 *           priority     : "",   // "low" | "medium" | "high" | "urgent"
 *           search       : ""    // matches against task.title
 *       }
 *   );
 *   // board.statuses = [ ProjectStatus entities, sort_order ASC ]
 *   // board.columns  = {
 *   //     "<statusId>"   : { status : <entity>, tasks : [ ... ] },
 *   //     ""             : { status : "",       tasks : [ ... ] }   // unassigned-status bucket
 *   // }
 *   // board.totalTasks = N
 *   // board.filters    = the applied filter struct (for view binding)
 */
class singleton=true {

    property name="taskService"          inject="TaskService@tesserabx-pm";
    property name="projectStatusService" inject="ProjectStatusService@tesserabx-pm";
    property name="wirebox"              inject="wirebox";

    /**
     * Build the board state for a project. Returns a struct the
     * view can render directly. Filters are optional and compose
     * with AND semantics.
     */
    public struct function buildBoard(
        required string projectId,
        struct filters = {}
    ){
        var safeFilters = normalizeFilters( arguments.filters );

        var statuses = projectStatusService.listForProject( arguments.projectId );
        var tasks    = taskService.listForProject(
            projectId    = arguments.projectId,
            statusId     = safeFilters.statusId,
            assigneeType = safeFilters.assigneeType,
            assigneeId   = safeFilters.assigneeId,
            priority     = safeFilters.priority,
            search       = safeFilters.search,
            limit        = 500
        );
        tasks = applyLabelFilter( tasks, safeFilters.labelIds );

        return {
            statuses     : statuses,
            columns      : groupTasks( tasks, statuses ),
            totalTasks   : arrayLen( tasks ),
            filters      : safeFilters,
            labelsByTask : labelsForTasks( tasks ),
            slaByTask    : slaForTasks( tasks )
        };
    }

    /**
     * Convenience: return only the column bucket for a single
     * status. The kanban CBWire components in Phase 3b call this
     * for the per-column re-renders that follow a drag-drop or
     * quick-add (re-rendering the whole board on every action is
     * wasteful).
     */
    public struct function buildColumn(
        required string projectId,
        required string statusId,
        struct filters = {}
    ){
        var safeFilters = normalizeFilters( arguments.filters );
        safeFilters.statusId = arguments.statusId;
        var tasks = taskService.listForProject(
            projectId    = arguments.projectId,
            statusId     = arguments.statusId,
            assigneeType = safeFilters.assigneeType,
            assigneeId   = safeFilters.assigneeId,
            priority     = safeFilters.priority,
            search       = safeFilters.search,
            limit        = 500
        );
        tasks = applyLabelFilter( tasks, safeFilters.labelIds );
        var status = projectStatusService.getStatus( arguments.statusId );
        return {
            status       : isNull( status ) ? "" : status,
            tasks        : tasks,
            filters      : safeFilters,
            labelsByTask : labelsForTasks( tasks ),
            slaByTask    : slaForTasks( tasks )
        };
    }

    // ---------- internals ----------

    private struct function normalizeFilters( required any filters ){
        var f = isStruct( arguments.filters ) ? arguments.filters : {};
        var rawLabels = f.labelIds ?: [];
        var labelIds  = [];
        if ( isArray( rawLabels ) ) {
            for ( var lid in rawLabels ) {
                if ( isSimpleValue( lid ) && len( lid ) ) labelIds.append( lid );
            }
        } else if ( isSimpleValue( rawLabels ) && len( rawLabels ) ) {
            // wire:model on a multi-select can hand a comma-joined
            // string when only one option is picked on certain
            // browsers; tolerate it.
            for ( var lid in listToArray( rawLabels, "," ) ) {
                if ( len( trim( lid ) ) ) labelIds.append( trim( lid ) );
            }
        }
        return {
            statusId     : trim( f.statusId     ?: "" ),
            assigneeType : trim( f.assigneeType ?: "" ),
            assigneeId   : trim( f.assigneeId   ?: "" ),
            priority     : trim( f.priority     ?: "" ),
            search       : trim( f.search       ?: "" ),
            labelIds     : labelIds
        };
    }

    /**
     * Batch-fetch the labels attached to every task in the result
     * set. Returns a struct keyed by task_id mapping to an array of
     * `{ id, name, color }` structs (kept light so the template
     * does not need entity getters and JSON serialisation stays
     * cheap). One indexed join, regardless of task or label
     * cardinality.
     */
    private struct function labelsForTasks( required array tasks ){
        var out = {};
        if ( !arrayLen( arguments.tasks ) ) return out;

        var taskIds = [];
        for ( var t in arguments.tasks ) {
            taskIds.append( t.getId() );
            out[ t.getId() ] = [];
        }

        var rows = queryExecute(
            "SELECT tl.task_id, l.id, l.name, l.color, l.sort_order
             FROM   pm_task_labels tl
             JOIN   pm_labels      l  ON l.id = tl.label_id
             WHERE  tl.task_id IN ( :tids )
             ORDER BY l.sort_order ASC, l.name ASC",
            { tids : { value : taskIds.toList(), list : true } }
        );
        for ( var i = 1; i <= rows.recordCount; i++ ) {
            var tid = rows.task_id[ i ];
            if ( !structKeyExists( out, tid ) ) continue;
            out[ tid ].append( {
                id    : rows.id[ i ],
                name  : rows.name[ i ],
                color : rows.color[ i ] ?: ""
            } );
        }
        return out;
    }

    /**
     * Aggregate SLA state for every task on the board: walks
     * pm_task_tickets for the task set in one query, asks the host
     * `SlaService` for the worst SLA status across each task's
     * linked tickets, and returns a struct keyed by task_id with
     * the worst status + a count of linked tickets.
     *
     * Worst order: "breached" > "approaching" > "ok" > "paused" >
     * "met" > "none". The kanban chip badges only fire on breached
     * or approaching, so the lower statuses still bubble up but the
     * template chooses what to render.
     *
     * Missing SLA module / missing tickets / per-ticket failure are
     * silently skipped so a misconfigured installation never breaks
     * board rendering.
     */
    private struct function slaForTasks( required array tasks ){
        var out = {};
        if ( !arrayLen( arguments.tasks ) ) return out;

        var taskIds = [];
        for ( var t in arguments.tasks ) {
            taskIds.append( t.getId() );
            out[ t.getId() ] = { status : "none", linkedCount : 0 };
        }

        // Pull the task->ticket map in one batch.
        var ticketsByTask = {};
        var ticketIds     = {};
        var linkRows = queryExecute(
            "SELECT task_id, ticket_id FROM pm_task_tickets WHERE task_id IN ( :tids )",
            { tids : { value : taskIds.toList(), list : true } }
        );
        for ( var i = 1; i <= linkRows.recordCount; i++ ) {
            var tid = linkRows.task_id[ i ];
            var ticketId = linkRows.ticket_id[ i ];
            if ( !structKeyExists( ticketsByTask, tid ) ) ticketsByTask[ tid ] = [];
            ticketsByTask[ tid ].append( ticketId );
            ticketIds[ ticketId ] = true;
            out[ tid ].linkedCount += 1;
        }
        if ( structIsEmpty( ticketIds ) ) return out;

        // Resolve the SLA service once. Missing module short-circuits.
        var slaSvc = "";
        try { slaSvc = wirebox.getInstance( "SlaService@sla" ); }
        catch ( any e ) { return out; }
        var ticketsSvc = "";
        try { ticketsSvc = wirebox.getInstance( "TicketsService@tickets" ); }
        catch ( any e ) { return out; }

        // Walk per ticket; cache by ticket id so multiple tasks
        // sharing the same ticket only compute once.
        var statusByTicket = {};
        for ( var ticketId in ticketIds ) {
            try {
                var ticket = ticketsSvc.getTicket( ticketId );
                if ( isNull( ticket ) ) continue;
                var summary = slaSvc.slaSummaryForTicket( ticket );
                statusByTicket[ ticketId ] = summary.status ?: "none";
            } catch ( any e ) { /* swallow per-ticket */ }
        }

        // Bubble the worst status up to each task.
        for ( var tid in ticketsByTask ) {
            var worst = "none";
            for ( var ticketId in ticketsByTask[ tid ] ) {
                var s = statusByTicket[ ticketId ] ?: "none";
                if ( slaSeverity( s ) > slaSeverity( worst ) ) worst = s;
            }
            out[ tid ].status = worst;
        }
        return out;
    }

    private numeric function slaSeverity( required string status ){
        switch ( arguments.status ) {
            case "breached":    return 5;
            case "approaching": return 4;
            case "ok":          return 3;
            case "paused":      return 2;
            case "met":         return 1;
            default:            return 0;
        }
    }

    /**
     * Narrow the task list to tasks that wear at least one of the
     * supplied label ids. OR semantics, not AND, so a multi-select
     * widens the result.
     */
    private array function applyLabelFilter( required array tasks, required array labelIds ){
        if ( !arrayLen( arguments.labelIds ) ) return arguments.tasks;
        if ( !arrayLen( arguments.tasks ) )    return arguments.tasks;

        var taskIds = [];
        for ( var t in arguments.tasks ) taskIds.append( t.getId() );

        var rows = queryExecute(
            "SELECT DISTINCT task_id
             FROM   pm_task_labels
             WHERE  task_id  IN ( :tids )
               AND  label_id IN ( :lids )",
            {
                tids : { value : taskIds.toList(),            list : true },
                lids : { value : arguments.labelIds.toList(), list : true }
            }
        );
        var matching = {};
        for ( var i = 1; i <= rows.recordCount; i++ ) matching[ rows.task_id[ i ] ] = true;

        var out = [];
        for ( var t in arguments.tasks ) {
            if ( structKeyExists( matching, t.getId() ) ) out.append( t );
        }
        return out;
    }

    /**
     * Bucket the tasks under their status_id. Statuses missing from
     * the project (or null status_id rows) land in the "" bucket so
     * the view can render an "Unassigned status" column.
     */
    private struct function groupTasks( required array tasks, required array statuses ){
        var columns = {};
        for ( var s in arguments.statuses ) {
            columns[ s.getId() ] = { status : s, tasks : [] };
        }
        columns[ "" ] = { status : "", tasks : [] };

        for ( var t in arguments.tasks ) {
            var key = t.getStatusId() ?: "";
            if ( !structKeyExists( columns, key ) ) key = "";
            columns[ key ].tasks.append( t );
        }
        return columns;
    }

}

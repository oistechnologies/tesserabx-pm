/**
 * Label: a per-project tag applied to tasks via pm_task_labels.
 */
class
    extends="tesserabx.modules.contacts.models.TesseraBXEntity"
    table="pm_labels"
    accessors="true"
{

    property name="id";
    property name="projectId"        column="project_id";
    property name="organizationId"   column="organization_id";

    property name="name";
    property name="color";
    property name="sortOrder"        column="sort_order";

    property name="createdAt"        column="created_at" sqltype="timestamp";
    property name="updatedAt"        column="updated_at" sqltype="timestamp";

    function applyGlobalScopes( builder ){
        variables._wirebox.getInstance( "TenantScope@contacts" ).apply( arguments.builder );
        return this;
    }

    function project(){
        return belongsTo( "Project@tesserabx-pm", "project_id" );
    }

    function tasks(){
        return belongsToMany(
            relationName     = "Task@tesserabx-pm",
            table            = "pm_task_labels",
            foreignPivotKey  = "label_id",
            relatedPivotKey  = "task_id"
        );
    }

}

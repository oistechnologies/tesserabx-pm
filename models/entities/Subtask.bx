/**
 * Subtask: the lightweight child of Task per BUILD-PLAN §3.1.
 *
 * Binary completion, polymorphic assignee, optional due_date and
 * estimated_hours. No status set, no custom fields, no embeddings.
 * Tenant-scoped via denormalized organization_id from the parent
 * task. Soft-deletes via deleted_at.
 */
class
    extends="tesserabx.modules.contacts.models.TesseraBXEntity"
    table="pm_subtasks"
    accessors="true"
{

    property name="id";
    property name="taskId"           column="task_id";
    property name="organizationId"   column="organization_id";

    property name="title";
    property name="description";

    property name="assigneeType"     column="assignee_type";
    property name="assigneeId"       column="assignee_id";

    property name="dueDate"          column="due_date" sqltype="date";
    property name="estimatedHours"   column="estimated_hours" sqltype="decimal";

    property name="isCompleted"      column="is_completed";
    property name="completedAt"      column="completed_at" sqltype="timestamp";
    property name="sortOrder"        column="sort_order";

    property name="createdByType"    column="created_by_type";
    property name="createdById"      column="created_by_id";

    property name="createdAt"        column="created_at" sqltype="timestamp";
    property name="updatedAt"        column="updated_at" sqltype="timestamp";
    property name="deletedAt"        column="deleted_at" sqltype="timestamp";

    function applyGlobalScopes( builder ){
        variables._wirebox.getInstance( "TenantScope@contacts" ).apply( arguments.builder );
        return this;
    }

    function task(){
        return belongsTo( "Task@tesserabx-pm", "task_id" );
    }

}

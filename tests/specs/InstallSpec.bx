/**
 * tesserabx-pm InstallSpec: the CI gate.
 *
 * Verifies that every contribution PM's ModuleConfig.bx declares
 * actually lands in the right host registry. The Phase 0 baseline
 * is a single probe — the host discovered PM and reports it as
 * compatible. Each subsequent phase appends probes for the
 * manifest deltas it introduces, so a silently-dropped registry
 * entry (typo'd key, wrong shape) fails the suite immediately.
 *
 * Modeled on sample-addons/example-sync/tests/specs/InstallSpec.bx
 * in the host repo.
 */
class extends="coldbox.system.testing.BaseTestCase" appMapping="/" {

    function beforeAll(){
        super.beforeAll();
        super.setup();
        variables.wb           = getController().getWireBox();
        variables.addonSvc     = variables.wb.getInstance( "AddonRegistryService@core" );
        variables.permissions  = variables.wb.getInstance( "PermissionRegistry@agent" );
        variables.roles        = variables.wb.getInstance( "RoleRegistry@agent" );
        variables.nav          = variables.wb.getInstance( "NavigationRegistry@core" );
        variables.adminPages   = variables.wb.getInstance( "AdminPagesRegistry@admin" );
        variables.settingsReg  = variables.wb.getInstance( "SettingsRegistry@core" );
        variables.routeClaims  = variables.wb.getInstance( "RouteClaimsRegistry@core" );
        variables.apiResources = variables.wb.getInstance( "ApiResourceRegistry@api" );
        variables.assetService     = variables.wb.getInstance( "AddonAssetService@core" );
        variables.webhookRegistry  = variables.wb.getInstance( "WebhookEventRegistry@api" );
        variables.auditService     = variables.wb.getInstance( "AuditService@audit" );
        variables.widgetRegistry   = variables.wb.getInstance( "DashboardWidgetRegistry@reporting" );
    }

    function run(){
        describe( "tesserabx-pm add-on InstallSpec", function(){

            it( "is discovered and recorded in the addons table", function(){
                var row = variables.addonSvc.findById( "tesserabx-pm" );
                expect( row ).notToBeNull();
                expect( row.addonId ).toBe( "tesserabx-pm" );
                expect( row.displayName ).toBe( "Project Management" );
            } );

            it( "is reported as compatible against the running core version", function(){
                var row = variables.addonSvc.findById( "tesserabx-pm" );
                expect( row ).notToBeNull();
                expect( row.compatible ).toBeTrue(
                    "Expected compatible=true, got compatibility_message=[" & ( row.compatibilityMessage ?: "" ) & "]"
                );
            } );

            it( "does not declare requiresAi at this phase", function(){
                var row = variables.addonSvc.findById( "tesserabx-pm" );
                expect( row ).notToBeNull();
                expect( !!row.requiresAi ).toBeFalse();
            } );

            // ---- Phase 1: permissions, roles, navigation,
            //               admin landing card, per-tenant settings.

            it( "registers all 6 PM permissions in PermissionRegistry@agent", function(){
                var ids = variables.permissions.listAll().map( ( p ) => p.id );
                expect( ids ).toInclude( "pm.view" );
                expect( ids ).toInclude( "pm.create" );
                expect( ids ).toInclude( "pm.edit" );
                expect( ids ).toInclude( "pm.delete" );
                expect( ids ).toInclude( "pm.assign-client" );
                expect( ids ).toInclude( "pm.admin" );
            } );

            it( "registers all 6 PM roles in RoleRegistry@agent", function(){
                expect( variables.roles.findById( "pm-admin"               ) ).notToBeNull();
                expect( variables.roles.findById( "pm-manager"             ) ).notToBeNull();
                expect( variables.roles.findById( "pm-contributor"         ) ).notToBeNull();
                expect( variables.roles.findById( "pm-viewer"              ) ).notToBeNull();
                expect( variables.roles.findById( "pm-client-viewer"       ) ).notToBeNull();
                expect( variables.roles.findById( "pm-client-contributor"  ) ).notToBeNull();
            } );

            it( "pm-admin role binds every PM permission", function(){
                var perms = variables.roles.permissionsFor( "pm-admin" );
                expect( perms ).toInclude( "pm.view" );
                expect( perms ).toInclude( "pm.create" );
                expect( perms ).toInclude( "pm.edit" );
                expect( perms ).toInclude( "pm.delete" );
                expect( perms ).toInclude( "pm.assign-client" );
                expect( perms ).toInclude( "pm.admin" );
            } );

            it( "client-side roles target the contact surface", function(){
                expect( variables.roles.findById( "pm-client-viewer"      ).surface ).toBe( "contact" );
                expect( variables.roles.findById( "pm-client-contributor" ).surface ).toBe( "contact" );
            } );

            it( "registers the agent main and portal main nav entries", function(){
                expect( variables.nav.findById( "pm.agent.main"  ) ).notToBeNull();
                expect( variables.nav.findById( "pm.portal.main" ) ).notToBeNull();
            } );

            it( "agent nav points at the BUILD-PLAN /agent/pm route", function(){
                var entry = variables.nav.findById( "pm.agent.main" );
                expect( entry ).notToBeNull();
                expect( entry.route   ).toBe( "/agent/pm" );
                expect( entry.surface ).toBe( "agent" );
                expect( entry.requiredPermission ).toBe( "pm.view" );
            } );

            it( "portal nav points at the BUILD-PLAN /pm route", function(){
                var entry = variables.nav.findById( "pm.portal.main" );
                expect( entry ).notToBeNull();
                expect( entry.route   ).toBe( "/pm" );
                expect( entry.surface ).toBe( "portal" );
            } );

            it( "admin landing card points at the BUILD-PLAN /agent/admin/pm route", function(){
                var hits = variables.adminPages.listAll().filter( ( c ) => c.id == "pm.admin.landing" );
                expect( hits.len() ).toBe( 1 );
                expect( hits[ 1 ].route ).toBe( "/agent/admin/pm" );
            } );

            it( "portal nav targets the portal surface", function(){
                var entry = variables.nav.findById( "pm.portal.main" );
                expect( entry ).notToBeNull();
                expect( entry.surface ).toBe( "portal" );
                expect( entry.requiredPermission ).toBe( "pm.view" );
            } );

            it( "registers the PM admin landing card with pm.admin gating", function(){
                var hits = variables.adminPages.listAll().filter( ( c ) => c.id == "pm.admin.landing" );
                expect( hits.len() ).toBe( 1 );
                expect( hits[ 1 ].requiredPermission ).toBe( "pm.admin" );
            } );

            it( "claims the two cross-surface BUILD-PLAN URLs in RouteClaimsRegistry@core", function(){
                // /agent/pm itself is now owned by PM's module Router
                // (entryPoint='agent/pm') and is NOT a route claim.
                // The two cross-surface URLs that PM's own router
                // cannot reach (portal + admin) ARE route claims.
                expect( variables.routeClaims.findByPath( "/pm"             ) ).notToBeNull();
                expect( variables.routeClaims.findByPath( "/agent/admin/pm" ) ).notToBeNull();
                expect( variables.routeClaims.findByPath( "/agent/pm"       ) ).toBeNull();
                for ( var path in [ "/pm", "/agent/admin/pm" ] ) {
                    var claim = variables.routeClaims.findByPath( path );
                    expect( claim.module  ).toBe( "tesserabx-pm" );
                    expect( claim.handler ).toBe( "Main" );
                    expect( claim.action  ).toBe( "index" );
                }
            } );

            // ---- Phase 2a: project CRUD service wiring.

            it( "binds ProjectService@tesserabx-pm in WireBox", function(){
                var svc = variables.wb.getInstance( "ProjectService@tesserabx-pm" );
                expect( svc ).notToBeNull();
            } );

            it( "binds VisibilityService@tesserabx-pm in WireBox", function(){
                var svc = variables.wb.getInstance( "VisibilityService@tesserabx-pm" );
                expect( svc ).notToBeNull();
            } );

            it( "binds ProjectDto@tesserabx-pm in WireBox", function(){
                var dto = variables.wb.getInstance( "ProjectDto@tesserabx-pm" );
                expect( dto ).notToBeNull();
            } );

            // ---- Phase 2b: Task / Subtask CRUD wiring.

            it( "binds ProjectStatusService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "ProjectStatusService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds TaskService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "TaskService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds SubtaskService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "SubtaskService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds TaskDto@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "TaskDto@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds SubtaskDto@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "SubtaskDto@tesserabx-pm" ) ).notToBeNull();
            } );

            // ---- Phase 3a: kanban board service wiring.

            it( "binds BoardService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "BoardService@tesserabx-pm" ) ).notToBeNull();
            } );

            // ---- Phase 3b: CBWire kanban + drag-drop assets.

            it( "registers the board CSS asset for the agent surface", function(){
                var assets   = variables.assetService.listForSurface( "agent" );
                var cssHrefs = assets.filter( ( a ) => a.kind == "css" ).map( ( a ) => a.href );
                expect( cssHrefs ).toInclude( "/modules/tesserabx-pm/resources/css/board.css" );
            } );

            it( "registers the SortableJS vendor + board.js for the agent surface", function(){
                var assets  = variables.assetService.listForSurface( "agent" );
                var jsSrcs  = assets.filter( ( a ) => a.kind == "js" ).map( ( a ) => a.src );
                expect( jsSrcs ).toInclude( "/modules/tesserabx-pm/resources/vendor/sortablejs-1.15.6/Sortable.min.js" );
                expect( jsSrcs ).toInclude( "/modules/tesserabx-pm/resources/js/board.js" );
            } );

            // ---- Phase 4a: collaboration services + webhook events.

            it( "binds CommentService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "CommentService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds MentionService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "MentionService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds WatcherService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "WatcherService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds CommentDto@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "CommentDto@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "registers webhookEvents for the Phase 4a lifecycle keys", function(){
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.comment_added"        ) ).toBeTrue();
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.project_created"     ) ).toBeTrue();
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.task_created"        ) ).toBeTrue();
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.task_assigned"       ) ).toBeTrue();
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.task_status_changed" ) ).toBeTrue();
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.task_completed"      ) ).toBeTrue();
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.subtask_created"     ) ).toBeTrue();
                expect( variables.webhookRegistry.isRegistered( "tesserabx-pm.subtask_completed"   ) ).toBeTrue();
            } );

            // ---- Phase 2c: REST API surface.

            it( "claims every /api/v1/pm/* endpoint in RouteClaimsRegistry@core", function(){
                // Projects (7 entries)
                expect( variables.routeClaims.findByPath( "/api/v1/pm/projects"             ) ).notToBeNull();
                expect( variables.routeClaims.findByPath( "/api/v1/pm/projects/:id"         ) ).notToBeNull();
                expect( variables.routeClaims.findByPath( "/api/v1/pm/projects/:id/archive" ) ).notToBeNull();
                expect( variables.routeClaims.findByPath( "/api/v1/pm/projects/:id/restore" ) ).notToBeNull();
                // Tasks (3 paths covering 5 verbs)
                expect( variables.routeClaims.findByPath( "/api/v1/pm/projects/:projectId/tasks" ) ).notToBeNull();
                expect( variables.routeClaims.findByPath( "/api/v1/pm/tasks/:id"                 ) ).notToBeNull();
                // Subtasks (2 paths covering 4 verbs)
                expect( variables.routeClaims.findByPath( "/api/v1/pm/tasks/:taskId/subtasks" ) ).notToBeNull();
                expect( variables.routeClaims.findByPath( "/api/v1/pm/subtasks/:id"           ) ).notToBeNull();
            } );

            it( "registers every CRUD endpoint in ApiResourceRegistry@api", function(){
                expect( variables.apiResources.findById( "pm.projects.list"    ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.projects.create"  ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.projects.show"    ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.projects.update"  ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.projects.delete"  ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.projects.archive" ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.projects.restore" ) ).notToBeNull();

                expect( variables.apiResources.findById( "pm.tasks.list"    ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.tasks.create"  ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.tasks.show"    ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.tasks.update"  ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.tasks.delete"  ) ).notToBeNull();

                expect( variables.apiResources.findById( "pm.subtasks.list"   ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.subtasks.create" ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.subtasks.update" ) ).notToBeNull();
                expect( variables.apiResources.findById( "pm.subtasks.delete" ) ).notToBeNull();
            } );

            it( "the projects list endpoint is wired with the expected permission gate", function(){
                var resource = variables.apiResources.findById( "pm.projects.list" );
                expect( resource ).notToBeNull();
                expect( resource.method ).toBe( "GET" );
                expect( resource.path ).toBe( "/api/v1/pm/projects" );
                expect( resource.handler ).toBe( "api.v1.Projects" );
                expect( resource.action ).toBe( "index" );
                expect( resource.requiresAuth ).toBeTrue();
                expect( resource.requiredPermission ).toBe( "pm.view" );
            } );

            it( "registers the pm.default-template-id per-tenant setting", function(){
                var descs = variables.settingsReg.listDescriptors( "tesserabx-pm" );
                var keys  = descs.map( ( s ) => s.key );
                expect( keys ).toInclude( "pm.default-template-id" );
                var desc = descs.filter( ( s ) => s.key == "pm.default-template-id" )[ 1 ];
                expect( desc.type      ).toBe( "string" );
                expect( desc.perTenant ).toBeTrue();
                expect( desc.secret    ).toBeFalse();
            } );

            // ---- Phase 4b: domain timeline + audit event types.

            it( "binds ProjectEventService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "ProjectEventService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds ProjectEventDto@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "ProjectEventDto@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "registers the five PM compliance audit event types", function(){
                var types = variables.auditService.listEventTypes();
                expect( types ).toInclude( "tesserabx-pm.project_created" );
                expect( types ).toInclude( "tesserabx-pm.project_archived" );
                expect( types ).toInclude( "tesserabx-pm.project_deleted" );
                expect( types ).toInclude( "tesserabx-pm.task_assigned_to_contact" );
                expect( types ).toInclude( "tesserabx-pm.template_applied" );
            } );

            // ---- Phase 5: time tracking + reports + widget.

            it( "binds TimeTrackingService@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "TimeTrackingService@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "binds TimeLogDto@tesserabx-pm in WireBox", function(){
                expect( variables.wb.getInstance( "TimeLogDto@tesserabx-pm" ) ).notToBeNull();
            } );

            it( "registers the pm.timeThisWeek dashboard widget", function(){
                var ids = variables.widgetRegistry.listAll().map( ( w ) => w.id );
                expect( ids ).toInclude( "pm.timeThisWeek" );
            } );

            it( "registers the pm.agent.time-reports navigation entry", function(){
                var entry = variables.nav.findById( "pm.agent.time-reports" );
                expect( entry ).notToBeNull();
                expect( entry.route   ).toBe( "/agent/pm/time-reports" );
                expect( entry.surface ).toBe( "agent" );
                expect( entry.requiredPermission ).toBe( "pm.view" );
            } );

            // Phase 2+ probes are appended below as registries are
            // populated. The shape mirrors the example-sync spec:
            // one `it()` per (registry, contribution kind) pair.

        } );
    }

}

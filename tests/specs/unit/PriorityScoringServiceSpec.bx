/**
 * PriorityScoringServiceSpec: deterministic priority scorer coverage
 * (Phase 13c).
 *
 * The scorer is pure-function (no AI, no service calls beyond a Quick
 * entity hydrate). Each spec asserts one rule from BUILD-PLAN §12:
 *
 *   - Base priority weight (urgent=40 / high=25 / medium=10 / low=5)
 *   - Due-date pressure (+40 overdue / +25 24h / +10 7d / +0 farther)
 *   - Age bonus (+10 when older than 14 days)
 *   - Cap at 100
 *   - Completed/deleted tasks score 0 regardless
 *
 * topForAgent gets its own spec: it walks every open assigned task,
 * scores each, returns the highest. The tie-break is due date asc,
 * created_at desc.
 */
class extends="coldbox.system.testing.BaseTestCase" appMapping="/" {

    function beforeAll(){
        super.beforeAll();
        super.setup();
        variables.wb        = getController().getWireBox();
        variables.svc       = variables.wb.getInstance( "PriorityScoringService@tesserabx-pm" );
        variables.taskSvc   = variables.wb.getInstance( "TaskService@tesserabx-pm" );
        variables.projSvc   = variables.wb.getInstance( "ProjectService@tesserabx-pm" );
    }

    function run(){
        describe( "PriorityScoringService@tesserabx-pm", function(){

            var fixtureOrgIds = [];

            afterEach( function( currentSpec ){
                for ( var orgId in fixtureOrgIds ) {
                    queryExecute( "DELETE FROM organizations WHERE id = :id", { id : orgId } );
                }
                fixtureOrgIds = [];
            } );

            it( "scoreTask returns 0 for a completed task regardless of priority", function(){
                var ctx = newProject( fixtureOrgIds );
                var task = variables.taskSvc.createTask( {
                    projectId      : ctx.projectId,
                    organizationId : ctx.orgId,
                    title          : "Completed urgent",
                    priority       : "urgent"
                } );
                queryExecute(
                    "UPDATE pm_tasks SET completed_at = CURRENT_TIMESTAMP WHERE id = :id",
                    { id : task.getId() }
                );
                var fresh = variables.taskSvc.getTask( task.getId() );
                expect( variables.svc.scoreTask( fresh ) ).toBe( 0 );
            } );

            it( "scoreTask returns 0 for a soft-deleted task", function(){
                var ctx = newProject( fixtureOrgIds );
                var task = variables.taskSvc.createTask( {
                    projectId      : ctx.projectId,
                    organizationId : ctx.orgId,
                    title          : "Will be deleted",
                    priority       : "urgent"
                } );
                queryExecute(
                    "UPDATE pm_tasks SET deleted_at = CURRENT_TIMESTAMP WHERE id = :id",
                    { id : task.getId() }
                );
                // TaskService.getTask filters out soft-deleted rows; hydrate
                // directly via Quick to keep the deleted entity in hand.
                var fresh = variables.wb.getInstance( "Task@tesserabx-pm" )
                    .withoutGlobalScope()
                    .where( "id", task.getId() )
                    .first();
                expect( fresh ).notToBeNull();
                expect( variables.svc.scoreTask( fresh ) ).toBe( 0 );
            } );

            it( "scoreTask base weight follows the documented table", function(){
                var ctx = newProject( fixtureOrgIds );
                var urgent = makeTask( ctx, "urgent task",   "urgent" );
                var high   = makeTask( ctx, "high task",     "high"   );
                var med    = makeTask( ctx, "med task",      "medium" );
                var low    = makeTask( ctx, "low task",      "low"    );
                expect( variables.svc.scoreTask( urgent ) ).toBeGTE( 40 );
                expect( variables.svc.scoreTask( high   ) ).toBeGTE( 25 );
                expect( variables.svc.scoreTask( med    ) ).toBeGTE( 10 );
                expect( variables.svc.scoreTask( low    ) ).toBeGTE( 5  );
            } );

            it( "scoreTask awards +40 overdue, +25 within 24h, +10 within 7d", function(){
                var ctx = newProject( fixtureOrgIds );
                // Due-date column is a DATE (no time), so day-offset arithmetic
                // keeps the test deterministic across time-of-day.
                var overdue   = makeTask( ctx, "overdue",   "low", dateAdd( "d", -2, now() ) );
                var thisWeek  = makeTask( ctx, "this week", "low", dateAdd( "d",  3, now() ) );
                var farFuture = makeTask( ctx, "far",       "low", dateAdd( "d", 60, now() ) );
                // Base low = 5; pressures add the documented amounts.
                expect( variables.svc.scoreTask( overdue  ) ).toBeGTE( 45 );  // 5 + 40
                expect( variables.svc.scoreTask( thisWeek ) ).toBeGTE( 15 );  // 5 + 10
                expect( variables.svc.scoreTask( farFuture ) ).toBe( 5 );     // 5 + 0 = base only
            } );

            it( "scoreTask never exceeds 100 even when every signal stacks", function(){
                var ctx = newProject( fixtureOrgIds );
                // Max stack: urgent (40) + overdue (40) + age bonus (10) = 90.
                // The cap is a safety net for future weight changes; assert
                // the current ceiling stays under the documented 100.
                var maxed = makeTask( ctx, "everything stacked", "urgent", dateAdd( "d", -2, now() ) );
                queryExecute(
                    "UPDATE pm_tasks SET created_at = CURRENT_TIMESTAMP - INTERVAL '30 days' WHERE id = :id",
                    { id : maxed.getId() }
                );
                var fresh = variables.taskSvc.getTask( maxed.getId() );
                var score = variables.svc.scoreTask( fresh );
                expect( score ).toBeLTE( 100 );
                expect( score ).toBeGTE( 90 ); // current ceiling
            } );

            it( "scoreBreakdown returns reasons[] with one entry per signal that fires", function(){
                var ctx = newProject( fixtureOrgIds );
                var t = makeTask( ctx, "breakdown", "high", dateAdd( "d", 3, now() ) );
                var b = variables.svc.scoreBreakdown( t );
                expect( b.base       ).toBe( 25 );
                expect( b.duePoints  ).toBe( 10 ); // due within 7d
                expect( b.total      ).toBeGTE( 35 );
                expect( arrayLen( b.reasons ) ).toBeGTE( 2 );
            } );

            it( "topForAgent returns the highest-scored open assigned task", function(){
                var ctx = newProject( fixtureOrgIds );
                var agentId = createUUID();
                makeAgent( agentId );
                var a = makeTaskFor( ctx, "low priority", "low",    dateAdd( "d", 30, now() ), "agent", agentId );
                var b = makeTaskFor( ctx, "urgent now",   "urgent", dateAdd( "h",  6, now() ), "agent", agentId );
                var c = makeTaskFor( ctx, "med future",   "medium", dateAdd( "d", 10, now() ), "agent", agentId );
                var top = variables.svc.topForAgent( agentId );
                expect( top.task ).notToBeNull();
                expect( top.task.getId() ).toBe( b.getId() );
                expect( top.score ).toBeGTE( 65 );
                // Cleanup agent fixture.
                queryExecute( "DELETE FROM agents WHERE id = :id", { id : agentId } );
            } );

            it( "topForAgent returns empty struct when the agent has no open tasks", function(){
                var top = variables.svc.topForAgent( createUUID() );
                expect( top.task ).toBeNull();
                expect( top.score ).toBe( 0 );
            } );

        } );
    }

    // ---------- fixtures ----------

    private struct function newProject( required array fixtureOrgIds ){
        var orgId = createUUID();
        queryExecute(
            "INSERT INTO organizations ( id, name, slug, is_active, created_at, updated_at )
             VALUES ( :id, :name, :slug, TRUE, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP )",
            { id : orgId, name : "pm-pss-" & createUUID(), slug : "pm-pss-" & lCase( replace( createUUID(), "-", "", "all" ) ) }
        );
        arguments.fixtureOrgIds.append( orgId );
        var p = variables.projSvc.createProject( {
            organizationId : orgId,
            name           : "PriorityScoring fixture"
        } );
        return { orgId : orgId, projectId : p.getId() };
    }

    private any function makeTask( required struct ctx, required string title, string priority = "medium", any dueDate = "" ){
        var t = variables.taskSvc.createTask( {
            projectId      : arguments.ctx.projectId,
            organizationId : arguments.ctx.orgId,
            title          : arguments.title,
            priority       : arguments.priority,
            dueDate        : len( toString( arguments.dueDate ) ) ? dateFormat( arguments.dueDate, "yyyy-mm-dd" ) : ""
        } );
        return variables.taskSvc.getTask( t.getId() );
    }

    private any function makeTaskFor(
        required struct ctx,
        required string title,
        required string priority,
        required any    dueDate,
        required string assigneeType,
        required string assigneeId
    ){
        var t = variables.taskSvc.createTask( {
            projectId      : arguments.ctx.projectId,
            organizationId : arguments.ctx.orgId,
            title          : arguments.title,
            priority       : arguments.priority,
            dueDate        : dateFormat( arguments.dueDate, "yyyy-mm-dd" ),
            assigneeType   : arguments.assigneeType,
            assigneeId     : arguments.assigneeId
        } );
        return variables.taskSvc.getTask( t.getId() );
    }

    private void function makeAgent( required string id ){
        queryExecute(
            "INSERT INTO agents ( id, email, password_hash, first_name, last_name, is_active, is_admin, created_at, updated_at, mfa_enabled )
             VALUES ( :id, :email, '', 'Spec', 'Agent', TRUE, FALSE, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP, FALSE )",
            { id : arguments.id, email : "pss-" & arguments.id & "@spec.test" }
        );
    }

}
